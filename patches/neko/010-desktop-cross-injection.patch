+# -*- coding: utf-8 -*-
+"""桌面跨端上下文每轮增量注入的测试（p1-1 1a-4，UC3 完整契约）。
+
+覆盖三层（与 wechat_integration 的 patch 002 测试对偶，范式同源）：
+
+1. HTTP helper（StreamingMixin._fetch_recent_history_increment）：请求形状
+   （URL/params/超时/共享 internal client）、200+status:error 拦截、失败 WARN
+   带 request_id、超时/连接异常降级；
+2. 水位/过滤逻辑（StreamingMixin._cross_context_refresh）：未对齐时先对齐
+   不注入（防与 /new_dialog 双重注入）、对齐失败保持未对齐下轮重试、活跃
+   会话增量注入、本会话回流消息按 (role, content) 过滤、失败降级水位不动、
+   无新条目不注入且水位单调；
+3. stream_text 集成：on_cross_context_refresh 回调块拼进本轮 user content
+   最前缀（在 agent 回调 system_prefix 之前）、随 HumanMessage 落 history、
+   回调异常不吞用户轮次；/new_dialog 取用成功后对齐标志复位。
+"""
+from __future__ import annotations
+
+import asyncio
+import os
+import sys
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock, patch
+
+import pytest
+
+sys.path.append(os.path.abspath(os.path.join(os.path.dirname(__file__), "../../")))
+
+from utils.llm_client import AIMessage, HumanMessage, SystemMessage
+from main_logic.core import LLMSessionManager
+from main_logic.omni_offline_client import OmniOfflineClient
+
+pytestmark = pytest.mark.unit
+
+_HER = "Xiaoba"
+_PORT = 48912
+
+
+class _Logger:
+    def __init__(self):
+        self.warnings: list[str] = []
+        self.infos: list[str] = []
+
+    def warning(self, msg, *args, **kwargs):
+        self.warnings.append(str(msg))
+
+    def info(self, msg, *args, **kwargs):
+        self.infos.append(str(msg))
+
+    def error(self, msg, *args, **kwargs):
+        pass
+
+    def debug(self, msg, *args, **kwargs):
+        pass
+
+
+def _make_manager(session_history: list | None = None):
+    """__new__ 绕过 __init__ 的轻量 manager，只接水位相关字段。"""
+    manager = LLMSessionManager.__new__(LLMSessionManager)
