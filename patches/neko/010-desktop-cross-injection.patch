+
+    async def _refresh(_text):
+        return "======[跨端最近对话]======\n主人: 微信消息\n======[跨端最近对话结束]======"
+
+    c.on_cross_context_refresh = _refresh
+
+    asyncio.run(c.stream_text(
+        "在吗",
+        system_prefix="======[系统通知] 来自agent的回调======",
