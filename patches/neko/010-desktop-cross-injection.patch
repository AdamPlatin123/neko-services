+
+    # ── 跨端最近对话每轮增量注入（p1-1 1a-4，UC3 完整契约）─────────────
+    # 此前桌面活跃会话只在 start_session 时取一次 /new_dialog（lifecycle
+    # 的预取 task），之后既不重启也不重取；recall 工具是模型主动调用、非每轮
+    # 必读——主人在 QQ/微信说的新话，桌面端不重启会话就永远看不到。这里把
+    # wechat_integration 已验证的"水位 + 增量"范式（见 neko-services patch 002）
+    # 对偶到桌面主进程：回调绑定在 OmniOfflineClient.on_cross_context_refresh
+    # （lifecycle._create_offline_vlm_client），stream_text 每轮组装 user content
+    # 前调用——文本轮与独立 ASR 语音轮（同样汇入 stream_text）一并覆盖。
+
+    async def _fetch_recent_history_increment(
+        self, since_seq: int, limit: int = 50,
+    ) -> dict | None:
+        """GET /recent_history/{her}?since_seq= 取共享记忆增量（p1-1 L1）。
+
+        与 wechat_integration._fetch_recent_history_increment 同一契约：成功
+        （HTTP 2xx 且 body ``status=ok``）返回完整 payload（entries/next_seq）；
+        任何失败返回 None——调用方降级为"跳过注入、水位不动、下轮重试"，
+        绝不阻塞回复。失败一律 WARN 带 request_id 便于按轮次追踪（S8 可观测）。
+        用共享 internal client（loopback 专用连接池，同 /new_dialog 取用方）。
+        """
+        request_id = uuid4().hex[:8]
+        try:
+            from utils.internal_http_client import get_internal_http_client
+
+            response = await get_internal_http_client().get(
+                f"http://127.0.0.1:{self.memory_server_port}"
+                f"/recent_history/{self.lanlan_name}",
+                params={"since_seq": int(since_seq), "limit": int(limit)},
+                timeout=5.0,
+            )
+            if not response.is_success:
+                logger.warning(
+                    "[%s] recent_history increment failed: status=%s "
+                    "since_seq=%s request_id=%s",
+                    self.lanlan_name, response.status_code, since_seq, request_id,
+                )
+                return None
+            payload = response.json()
+            if not isinstance(payload, dict) or payload.get("status") != "ok":
+                # 端点失败模式是 200 + status:error——统一在这里拦下（DX-2）
+                logger.warning(
+                    "[%s] recent_history increment error body: since_seq=%s "
+                    "body=%s request_id=%s",
+                    self.lanlan_name, since_seq, str(payload)[:200], request_id,
+                )
+                return None
+            return payload
+        except asyncio.CancelledError:
+            # 会话拆除会取消 stream_text，回调里的在途请求必须跟着取消，
+            # 不能被降级逻辑吞掉。
+            raise
+        except Exception as e:
+            logger.warning(
+                "[%s] recent_history increment unavailable: since_seq=%s "
+                "error=%s request_id=%s",
+                self.lanlan_name, since_seq, e, request_id,
+            )
+            return None
+
+    @staticmethod
+    def _cross_context_safe_next_seq(payload: dict, fallback: int) -> int:
+        """Parse ``next_seq`` defensively——畸形值不能让 int() 抛出。
+
+        回调抛出的异常虽然在上游 stream_text 有兜底，但对齐失败应当走
+        "保持现状、下轮重试"，而不是依赖外层吞异常。
+        """
+        try:
+            return int(payload.get("next_seq") or fallback)
+        except (TypeError, ValueError):
+            return fallback
+
+    @staticmethod
+    def _cross_context_flatten_message_text(message) -> str:
+        """Flatten a history message's content into plain text（多模态段拼接）."""
+        content = getattr(message, "content", "")
+        if isinstance(content, str):
+            return content
+        if isinstance(content, list):
+            parts = []
+            for item in content:
+                if isinstance(item, dict):
+                    parts.append(str(item.get("text") or item.get("content") or ""))
+                else:
+                    parts.append(str(item))
+            return "\n".join(parts)
+        return str(content or "")
+
+    def _cross_context_own_fingerprints(self, current_text: str) -> set[tuple[str, str]]:
+        """本会话消息的 (role, content) 指纹集合（回流过滤用）。
+
+        recent_history 不区分消息来源通道：桌面自己经 turn end /cache 回流的
+        消息也在增量里——用本会话 LLM history（OmniOfflineClient._conversation_history）
+        + 本轮文本精确匹配过滤。已知局限（与 wechat 侧同款）：跨端一字不差的
+        内容会被误滤一次（无害，只丢一次注入）；本会话 user 消息若带注入前缀
+        （跨端块/agent 回调随 user content 落 history），/cache 回流的是纯文本、
+        匹配失配时会把自己上一轮注入一次——同样无害。
+        """
+        own: set[tuple[str, str]] = set()
+        if current_text:
+            own.add(("user", current_text))
+        history = getattr(getattr(self, "session", None), "_conversation_history", None) or []
+        for message in history:
+            if isinstance(message, HumanMessage):
+                role = "user"
+            elif isinstance(message, AIMessage):
+                role = "assistant"
+            else:
+                continue
+            own.add((role, self._cross_context_flatten_message_text(message)))
+        return own
+
+    async def _cross_context_refresh(self, current_text: str) -> str | None:
+        """每轮生成前的跨端增量注入回调（p1-1 1a-4）。
+
+        水位语义（与 wechat_integration._refresh_cross_context 对偶）：
+
+        - 未对齐（``_cross_context_aligned`` False，/new_dialog 全量基线刚到场）：
+          先 GET ``since_seq=0&limit=1`` 把水位对齐到当前 ``next_seq``，**本轮不
+          注入**——注入即与 /new_dialog 的 recent 段双重注入。对齐失败保持未对齐，
+          下轮重试（等价延迟一轮）。
+        - 已对齐：按水位取增量，注入「[跨端最近对话]」块（stream_text 把它拼进
+          本轮 user content 前缀，随 HumanMessage 落 history——与 agent 回调
+          system_prefix 同语义，模型后续仍可 reference）；水位仅在成功拿到
+          payload 后推进，同一条消息不会注入两次。
+        - 失败降级：跳过注入 + WARN（带 request_id），水位不动下轮重试。
+        - 并发轮（用户打字与独立 ASR 语音撞车）用锁串行取水位，避免两个并发
+          回调拿到同批 entries 双注入；锁内只有 loopback HTTP（5s 超时）。
+        """
+        lock = getattr(self, "_cross_context_lock", None)
+        if lock is None:
+            # __new__ 绕过 __init__ 的轻量构造（上游测试习惯）没有这个锁——
+            # 与上游 proactive/attachment 槽位的防御式读法一致。
+            lock = self._cross_context_lock = asyncio.Lock()
+        async with lock:
+            if not getattr(self, "_cross_context_aligned", False):
+                payload = await self._fetch_recent_history_increment(since_seq=0, limit=1)
+                if payload is None:
+                    return None
+                self._cross_context_next_seq = self._cross_context_safe_next_seq(payload, 0)
+                self._cross_context_aligned = True
+                return None
+
+            watermark = int(getattr(self, "_cross_context_next_seq", 0) or 0)
+            payload = await self._fetch_recent_history_increment(since_seq=watermark)
+            if payload is None:
+                return None
+            next_seq = self._cross_context_safe_next_seq(payload, watermark)
+            self._cross_context_next_seq = max(next_seq, watermark)
+
+            entries = [
+                e for e in (payload.get("entries") or [])
+                if isinstance(e, dict) and str(e.get("content") or "").strip()
+            ]
+            own_turns = self._cross_context_own_fingerprints(str(current_text or "").strip())
+            injected = [
+                e for e in entries
+                if (str(e.get("role") or ""), str(e.get("content") or "")) not in own_turns
+            ]
+            if not injected:
+                return None
+            lines = [
+                f"{e.get('speaker') or e.get('role')}: {e.get('content')}"
+                for e in injected
+            ]
+            logger.info(
+                "[%s] cross-context increment: entries=%d/%d next_seq=%d",
+                self.lanlan_name, len(injected), len(entries), next_seq,
+            )
+            return (
+                "======[跨端最近对话]======\n"
+                "以下是刚刚在其他通道（QQ/微信等）发生的对话，供你了解近况；"
+                "不要主动复述，也无需回应其中已结束的话题：\n"
+                + "\n".join(lines)
+                + "\n======[跨端最近对话结束]======"
+            )
