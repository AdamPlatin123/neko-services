+def _client_mock(get_response):
+    """mock 共享 internal client：一个预设的 GET 响应。"""
+    client = MagicMock()
+    client.get = AsyncMock(return_value=get_response)
+    return client
+
+
+def _resp(payload=None, status_code=200, is_success=True, text=""):
+    return SimpleNamespace(
+        status_code=status_code,
+        is_success=is_success,
+        text=text,
+        json=(lambda p: (lambda: p))(payload),
+    )
+
+
+def _ok_payload(entries, next_seq):
