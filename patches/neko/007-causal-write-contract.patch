+async def _drive_cache_endpoint(tmp_path, bodies):
+    """POST /cache on the real app with hermetic runtime swaps; returns responses."""
+    import httpx
+    from app.memory_server import routes, runtime
+
+    mgr = _make_manager(tmp_path)
+
+    store_calls: list[list] = []
+    outbox_calls: list[str] = []
+
+    class _FakeTimeManager:
+        async def astore_conversation(self, uid, messages, name, timestamp=None):
+            store_calls.append(list(messages))
+
+    async def _fake_outbox(name, messages, **kwargs):
+        outbox_calls.append(name)
+
+    saved = (
+        runtime.recent_history_manager, runtime.time_manager,
+        runtime._config_manager,
+        runtime._memory_runtime_init_completed,
+        runtime._memory_storage_blocked_after_init,
+    )
+    runtime.recent_history_manager = mgr
+    runtime.time_manager = _FakeTimeManager()
+    runtime._config_manager = mgr._config_manager
+    runtime._memory_runtime_init_completed = True
+    runtime._memory_storage_blocked_after_init = False
+    from app.memory_server import post_turn as _post_turn
+    saved_outbox = _post_turn._spawn_outbox_post_turn_signals
+    _post_turn._spawn_outbox_post_turn_signals = _fake_outbox
+    try:
+        transport = httpx.ASGITransport(app=routes.app)
+        async with httpx.AsyncClient(
+            transport=transport, base_url="http://127.0.0.1",
+        ) as client:
+            responses = []
+            for body in bodies:
+                responses.append(await client.post(f"/cache/{_LANLAN}", json=body))
+            return responses, mgr, store_calls, outbox_calls
+    finally:
+        (
+            runtime.recent_history_manager, runtime.time_manager,
+            runtime._config_manager,
+            runtime._memory_runtime_init_completed,
+            runtime._memory_storage_blocked_after_init,
+        ) = saved
+        _post_turn._spawn_outbox_post_turn_signals = saved_outbox
+
+
+def _cache_body(contents: list[str], metadata: dict | None = None) -> dict:
+    body = {
+        "input_history": json.dumps([
+            {"type": "human", "data": {"content": c, "type": "human"}}
+            for c in contents
+        ]),
+        "language": "en",
+    }
+    if metadata is not None:
+        body["metadata"] = metadata
+    return body
+
+
+@pytest.mark.asyncio
+async def test_cache_endpoint_duplicate_turn_skips_side_effects(tmp_path):
+    dup_md = {"turn_uid": "turn-ep", "channel": "wechat", "session_id": "w1",
+              "client_ts": "2026-09-20T09:00:00"}
+    responses, mgr, store_calls, outbox_calls = await _drive_cache_endpoint(
+        tmp_path,
+        [
+            _cache_body(["endpoint turn"], dup_md),
+            _cache_body(["endpoint turn"], dup_md),  # 网络重试
+        ],
+    )
+
+    first, retry = (r.json() for r in responses)
+    assert first == {"status": "cached", "count": 1}
+    assert retry["status"] == "skipped_duplicate_turn"
+    assert retry["turn_uid"] == "turn-ep"
+    assert retry["existing_seq"] == 1
+    assert retry["count"] == 0
+
+    # 连带副作用零增加：time_indexed 与 outbox 都只看到首轮
+    assert len(store_calls) == 1
+    assert outbox_calls == [_LANLAN]
+
+    final = _read_disk_messages(mgr.log_file_path[_LANLAN])
+    assert len(final) == 1
+
