+# -*- coding: utf-8 -*-
+"""Causal write contract tests (UC3 Final Gate 1a-2, patch 007).
+
+HistoryRequest.metadata = {channel, session_id, turn_uid, client_ts,
+replaces_turn_uid}，向后兼容（不传=现状）。验收用例（设计文档 P1-1「必做
+不裁」）：
+
+1. 旧回合晚到（client_ts 乱序落库）→ recent_seq 仍按**到达序**分配，消息上
+   的 turn_uid/client_ts 可追溯；
+2. 相同 turn_uid 重复提交 → 临界区内幂等跳过（skipped 语义，零双写）；
+3. 时间相同（client_ts 相同）的双提交 → 同 turn_uid 只落一份；不同 turn_uid
+   是两个轮次，各自落库；
+4. corrected 场景（replaces_turn_uid）→ turn_replacements.json 记替代指针，
+   recent 仍是纯追加；
+5. HTTP /cache 端点：重复提交返回 status=skipped_duplicate_turn，连带
+   time_indexed/outbox 零副作用。
+"""
+from __future__ import annotations
+
+import asyncio
+import json
+import os
+from pathlib import Path
+
+import pytest
+
+from memory.recent import (
+    CLIENT_TS_KWARG,
+    TURN_REPLACEMENTS_FILENAME,
+    TURN_UID_KWARG,
+    CompressedRecentHistoryManager,
+    TurnWriteMetadata,
+    extract_recent_seq_entries,
+    message_recent_seq,
+)
+from utils.llm_client import AIMessage, HumanMessage
+
+pytestmark = pytest.mark.unit
+
+_LANLAN = "Xiaoba"
+_MASTER = "Master"
+
+
+class _FakeConfigManager:
+    def __init__(self, memory_dir: str, recent_log: dict):
+        self.memory_dir = memory_dir
+        self._recent_log = recent_log
+
+    def get_character_data(self):
+        return self.aget_character_data_sync()
+
+    def aget_character_data_sync(self):
+        return (
+            _MASTER, _LANLAN, None, {},
+            {"human": _MASTER, "ai": _LANLAN, "system": "SYSTEM_MESSAGE"},
+            None, None, None, self._recent_log,
+        )
+
+    async def aget_character_data(self):
+        return self.aget_character_data_sync()
+
+
+def _make_manager(tmp_path: Path) -> CompressedRecentHistoryManager:
+    file_path = str(tmp_path / "recent.json")
+    mgr = object.__new__(CompressedRecentHistoryManager)
+    mgr._config_manager = _FakeConfigManager(str(tmp_path), {_LANLAN: file_path})
+    mgr.max_history_length = 10
+    mgr.compress_threshold = 15
+    mgr.log_file_path = {_LANLAN: file_path}
+    mgr.name_mapping = {"human": _MASTER, "ai": _LANLAN, "system": "SYSTEM_MESSAGE"}
+    mgr.user_histories = {}
+    mgr._seq_counters = {}
+    return mgr
+
+
+def _read_disk_messages(file_path: str) -> list:
+    from utils.llm_client import messages_from_dict
+    with open(file_path, encoding="utf-8") as f:
+        return messages_from_dict(json.load(f))
+
+
+@pytest.fixture(autouse=True)
+def _patch_cloudsave(monkeypatch):
+    monkeypatch.setattr(
+        "memory.recent.assert_cloudsave_writable", lambda *a, **kw: None,
+    )
+
+
+def _turn(uid: str, *, client_ts: str = "2026-09-20T10:00:00", **kw) -> TurnWriteMetadata:
+    return TurnWriteMetadata(turn_uid=uid, client_ts=client_ts, **kw)
+
+
+# ─────────────────── 1. 乱序到达：seq 按到达序，turn_uid 可追溯 ───────────────────
+
+
+def test_late_arriving_turn_keeps_arrival_seq_and_causal_trace(tmp_path):
+    """旧回合（client_ts 更早）晚到：seq 按到达序连号，不按 client_ts 重排。"""
+    mgr = _make_manager(tmp_path)
+    file_path = mgr.log_file_path[_LANLAN]
+
+    # 新回合先到（client_ts 10:02）
+    asyncio.run(mgr.update_history(
+        [HumanMessage(content="new turn first"), AIMessage(content="reply new")],
+        _LANLAN, compress=False,
+        turn_metadata=_turn("turn-b", client_ts="2026-09-20T10:02:00"),
+    ))
+    # 旧回合后到（client_ts 10:01）——到达序在后，seq 也应在后
+    asyncio.run(mgr.update_history(
+        [HumanMessage(content="old turn late"), AIMessage(content="reply old")],
+        _LANLAN, compress=False,
+        turn_metadata=_turn("turn-a", client_ts="2026-09-20T10:01:00"),
+    ))
+
+    final = _read_disk_messages(file_path)
+    seqs = [message_recent_seq(m) for m in final]
+    assert seqs == [1, 2, 3, 4], f"seq 应按到达序连号，实际 {seqs}"
+    kwargs = [m.additional_kwargs for m in final]
+    assert [k[TURN_UID_KWARG] for k in kwargs] == ["turn-b", "turn-b", "turn-a", "turn-a"]
+    # client_ts 保留客户端发生时间——乱序由此可追溯（落库 ts 见 recent_seq_ts）
+    assert [k[CLIENT_TS_KWARG] for k in kwargs] == [
+        "2026-09-20T10:02:00", "2026-09-20T10:02:00",
+        "2026-09-20T10:01:00", "2026-09-20T10:01:00",
+    ]
+
+    # 增量提取同样透出因果字段
+    entries = extract_recent_seq_entries(final)
+    assert [e["turn_uid"] for e in entries] == ["turn-b", "turn-b", "turn-a", "turn-a"]
+    assert entries[2]["client_ts"] == "2026-09-20T10:01:00"
+
+
+# ─────────────────── 2/3. 幂等：重复 turn_uid 与时间相同双提交 ───────────────────
+
+
+def test_duplicate_turn_uid_is_idempotently_skipped(tmp_path):
+    mgr = _make_manager(tmp_path)
+    file_path = mgr.log_file_path[_LANLAN]
+
+    batch = [HumanMessage(content="dup turn"), AIMessage(content="dup reply")]
+    first = asyncio.run(mgr.update_history(
+        list(batch), _LANLAN, compress=False, turn_metadata=_turn("turn-x"),
+    ))
+    assert first is None, "首次提交正常写入，无 skipped 返回"
+
+    # 同一 turn_uid 重试（内容对象重建——网络重试就是重新序列化的）
+    retry = [HumanMessage(content="dup turn"), AIMessage(content="dup reply")]
+    outcome = asyncio.run(mgr.update_history(
+        retry, _LANLAN, compress=False, turn_metadata=_turn("turn-x"),
+    ))
+    assert outcome == {
+        "turn_skipped": True, "turn_uid": "turn-x", "existing_seq": 1,
+    }
+
+    final = _read_disk_messages(file_path)
+    assert len(final) == 2, "重复提交不得双写"
+    assert [message_recent_seq(m) for m in final] == [1, 2], "幂等跳过不占新 seq"
+
+
+def test_same_client_ts_distinct_turn_uids_both_persisted(tmp_path):
+    """时间相同（client_ts 相同）但 turn_uid 不同 = 两个真实轮次，各自落库。"""
+    mgr = _make_manager(tmp_path)
+    file_path = mgr.log_file_path[_LANLAN]
+    same_ts = "2026-09-20T11:00:00"
+
+    asyncio.run(mgr.update_history(
+        [HumanMessage(content="first at ts")], _LANLAN, compress=False,
+        turn_metadata=_turn("turn-1", client_ts=same_ts),
+    ))
+    asyncio.run(mgr.update_history(
+        [HumanMessage(content="second at ts")], _LANLAN, compress=False,
+        turn_metadata=_turn("turn-2", client_ts=same_ts),
+    ))
+
+    final = _read_disk_messages(file_path)
+    assert len(final) == 2
+    assert [m.additional_kwargs[TURN_UID_KWARG] for m in final] == ["turn-1", "turn-2"]
+    assert [message_recent_seq(m) for m in final] == [1, 2]
+
