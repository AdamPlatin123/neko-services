@@ -0,0 +1,291 @@
+# -*- coding: utf-8 -*-
+"""跨端上下文每轮增量注入的测试（p1-1 L1，workplan P1-1 #2）。
+
+覆盖三层：
+1. HTTP helper：请求形状（URL/params/超时/不走代理）、status:error 拦截、
+   失败 WARN 带 request_id；
+2. 水位/过滤逻辑（_refresh_cross_context）：新会话只对齐水位不注入（防与
+   /new_dialog 双重注入）、活跃会话增量注入、本会话回流消息按内容过滤、
+   失败降级水位不动；
+3. 回复全链路（_generate_wechat_reply mock 版）：跨端消息进入 system、
+   下一轮无增量时不重复注入（同轮去重的自动化断言）。
+"""
+from __future__ import annotations
+
+import asyncio
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, patch
+
+import pytest
+
+from plugin.plugins.wechat_integration import WechatIntegrationPlugin
+
+# _generate_wechat_reply 运行中会 `from main_logic.core import
+# apply_role_placeholders`——该模块的 import 链（utils.preferences）在模块级
+# 访问真实 ConfigManager 单例。生产环境中它在任何微信轮次之前早已导入；这里
+# 同样在打补丁前预导入，让补丁只作用于函数内的运行时调用。
+import main_logic.core  # noqa: F401
+
+pytestmark = pytest.mark.plugin_integration
+
+_HER = "Xiaoba"
+
+
+class _Logger:
+    def __init__(self):
+        self.warnings: list[str] = []
+        self.infos: list[str] = []
+
+    def warning(self, msg, *args, **kwargs):
+        self.warnings.append(str(msg))
+
+    def info(self, msg, *args, **kwargs):
+        self.infos.append(str(msg))
+
+    def error(self, msg, *args, **kwargs):
+        pass
+
+    def debug(self, msg, *args, **kwargs):
+        pass
+
+
+def _make_plugin() -> WechatIntegrationPlugin:
+    plugin = object.__new__(WechatIntegrationPlugin)
+    plugin.logger = _Logger()
+    plugin._wechat_sessions = {}
+    return plugin
+
+
+def _resp(payload=None, status_code=200, is_success=True):
+    return SimpleNamespace(
+        status_code=status_code,
+        is_success=is_success,
+        json=(lambda p: (lambda: p))(payload),
+    )
+
+
+def _client_mock(get_responses=None, post_response=None):
+    client = AsyncMock()
+    client.__aenter__.return_value = client
+    client.__aexit__.return_value = False
+    if get_responses is not None:
+        client.get = AsyncMock(side_effect=list(get_responses))
+    if post_response is not None:
+        client.post = AsyncMock(return_value=post_response)
+    return client
+
+
+# ─────────────────── 1. HTTP helper ───────────────────
+
+
+async def test_fetch_increment_request_shape_and_payload_passthrough():
+    plugin = _make_plugin()
+    payload = {"status": "ok", "entries": [{"seq": 3}], "next_seq": 4, "instance_id": "x"}
+    client = _client_mock(get_responses=[_resp(payload)])
+
+    with patch("httpx.AsyncClient", return_value=client) as ctor:
+        result = await plugin._fetch_recent_history_increment(_HER, since_seq=2)
+
+    assert result == payload
+    ctor.assert_called_once_with(timeout=5.0, proxy=None, trust_env=False)
+    url = client.get.await_args.args[0]
+    assert url.endswith(f"/recent_history/{_HER}")
+    assert client.get.await_args.kwargs["params"] == {"since_seq": 2, "limit": 50}
+
+
+async def test_fetch_increment_intercepts_error_body_and_warns_with_request_id():
+    plugin = _make_plugin()
+    # 端点失败模式：200 + status:error（与 /cache 一致）——必须在这里拦下
+    client = _client_mock(get_responses=[_resp({"status": "error", "message": "boom"})])
+
+    with patch("httpx.AsyncClient", return_value=client):
+        result = await plugin._fetch_recent_history_increment(_HER, since_seq=0)
+
+    assert result is None
+    assert len(plugin.logger.warnings) == 1
+    assert "request_id=" in plugin.logger.warnings[0]
+
+
+async def test_fetch_increment_degrades_on_exception():
+    plugin = _make_plugin()
+    with patch("httpx.AsyncClient", side_effect=TimeoutError("5s")):
+        result = await plugin._fetch_recent_history_increment(_HER, since_seq=3)
+    assert result is None
+    assert len(plugin.logger.warnings) == 1
+    assert "request_id=" in plugin.logger.warnings[0]
+
+
+# ─────────────────── 2. watermark / filter ───────────────────
+
+
+async def test_new_session_aligns_watermark_without_injection():
+    """/new_dialog 已渲染全部近期历史：新会话只取 next_seq 对齐水位、不注入。"""
+    plugin = _make_plugin()
+    session = {"history": []}
+    payload = {"status": "ok", "entries": [{"seq": 9, "content": "old"}], "next_seq": 10}
+    client = _client_mock(get_responses=[_resp(payload)])
+
+    with patch("httpx.AsyncClient", return_value=client):
+        block = await plugin._refresh_cross_context(
+            session, _HER, "hi", baseline_context="persona ctx",
+        )
+
+    assert block is None, "新会话有 /new_dialog 基线，注入即双重注入"
+    assert session["cross_context_next_seq"] == 10
+    # 对齐水位只需要 next_seq：limit=1
+    assert client.get.await_args.kwargs["params"] == {"since_seq": 0, "limit": 1}
+
+
+async def test_new_session_align_survives_malformed_next_seq():
+    """畸形 next_seq（非空字符串等）不能让 int() 抛出——否则异常被
+    _generate_wechat_reply 外层 except 吞掉，该轮整轮无回复（审查 F1）。"""
+    plugin = _make_plugin()
+    session = {"history": []}
+    payload = {"status": "ok", "entries": [], "next_seq": "garbage"}
+    client = _client_mock(get_responses=[_resp(payload)])
+
+    with patch("httpx.AsyncClient", return_value=client):
+        block = await plugin._refresh_cross_context(
+            session, _HER, "hi", baseline_context="persona ctx",
+        )
+
+    assert block is None
+    assert session["cross_context_next_seq"] == 0, "对齐失败保持水位 0，下轮重试"
+
+
+async def test_active_session_injects_increment_and_filters_own_messages():
+    plugin = _make_plugin()
+    session = {
+        "history": [
+            {"role": "user", "content": "hi"},
+            {"role": "assistant", "content": "yo"},
+        ],
+        "cross_context_next_seq": 2,
+    }
+    payload = {
+        "status": "ok",
+        "entries": [
+            # 本会话上一轮经 /cache 回流的消息：recent_history 无法区分来源，
+            # 按 (role, content) 匹配本会话滑窗过滤
+            {"seq": 3, "role": "user", "speaker": "主人", "content": "hi"},
+            {"seq": 4, "role": "assistant", "speaker": _HER, "content": "yo"},
+            # 真正的跨端增量
+            {"seq": 5, "role": "user", "speaker": "主人", "content": "桌面消息"},
+        ],
+        "next_seq": 6,
+    }
+    client = _client_mock(get_responses=[_resp(payload)])
+
+    with patch("httpx.AsyncClient", return_value=client):
+        block = await plugin._refresh_cross_context(
+            session, _HER, "new msg", baseline_context=None,
+        )
+
+    assert block is not None
+    assert "[跨端最近对话]" in block
+    assert "主人: 桌面消息" in block
+    assert "hi" not in block and "yo" not in block, "本会话消息不得进入注入块"
+    assert session["cross_context_next_seq"] == 6
+    assert client.get.await_args.kwargs["params"]["since_seq"] == 2
+
+
+async def test_failure_degrades_to_skip_and_keeps_watermark():
+    plugin = _make_plugin()
+    session = {"history": [], "cross_context_next_seq": 5}
+
+    with patch.object(
+        WechatIntegrationPlugin,
+        "_fetch_recent_history_increment",
+        new=AsyncMock(return_value=None),
+    ):
+        block = await plugin._refresh_cross_context(
+            session, _HER, "hi", baseline_context=None,
+        )
+
+    assert block is None
+    assert session["cross_context_next_seq"] == 5, "失败不推进水位，下轮重试"
+
+
+# ─────────────────── 3. reply 全链路 ───────────────────
+
+
+class _FakeLLM:
+    def __init__(self):
+        self.calls: list[list[dict]] = []
+
+    async def ainvoke(self, messages, **kwargs):
+        self.calls.append(messages)
+        return SimpleNamespace(content="好的呀")
+
+    async def aclose(self):
+        return None
+
+
+def _patched_config():
+    return SimpleNamespace(
+        get_character_data=lambda: (
+            "主人", _HER, None, {}, None, {_HER: "character prompt"},
+            None, None, None,
+        ),
+        get_model_api_config=lambda tier: {
+            "base_url": "http://llm.local", "model": "test-model",
+            "api_key": "k", "provider_type": None,
+        },
+    )
+
+
+async def _drive_turn(plugin: WechatIntegrationPlugin, fake_llm: _FakeLLM, get_responses):
+    """跑一轮 _generate_wechat_reply，返回 (system_prompt, 本轮 httpx client)。"""
+    client = _client_mock(get_responses=get_responses, post_response=_resp({"status": "cached"}))
+    with patch("httpx.AsyncClient", return_value=client), \
+         patch("utils.config_manager.get_config_manager", return_value=_patched_config()), \
+         patch("utils.llm_client.create_chat_llm_async", new=AsyncMock(return_value=fake_llm)), \
+         patch("utils.language_utils.get_global_language_full", return_value="zh-CN"), \
+         patch.object(
+             WechatIntegrationPlugin, "_fetch_memory_context",
+             new=AsyncMock(return_value="persona context"),
+         ):
+        plugin._cleanup_wechat_sessions = lambda now=None: None
+        reply = await plugin._generate_wechat_reply(user_id="wx-master", message="微信消息")
+    assert reply == "好的呀"
+    system_prompt = fake_llm.calls[-1][0]["content"]
+    return system_prompt, client
+
+
+async def test_reply_flow_injects_increment_once_across_turns():
+    """新会话对齐水位（不注入）→ 跨端增量注入一次 → 无增量不重复注入。"""
+    plugin = _make_plugin()
+    fake_llm = _FakeLLM()
+
+    # 第 1 轮（新会话）：/new_dialog 基线 + 水位对齐到 10，无注入
+    align = _resp({"status": "ok", "entries": [{"seq": 9, "content": "old"}], "next_seq": 10})
+    system1, client1 = await _drive_turn(plugin, fake_llm, [align])
+    assert "persona context" in system1
+    assert "[跨端最近对话]" not in system1
+    assert plugin._wechat_sessions["wx-master"]["cross_context_next_seq"] == 10
+
+    # 第 2 轮（活跃会话）：桌面增量 seq10 → 注入
+    increment = _resp({
+        "status": "ok",
+        "entries": [
+            {"seq": 10, "role": "user", "speaker": "主人", "content": "桌面消息"},
+            # 本轮自己的消息不在增量里（fetch 发生在 /cache 之前），但上一轮的
+            # 回流消息会出现——必须被过滤
+            {"seq": 11, "role": "user", "speaker": "主人", "content": "微信消息"},
+        ],
+        "next_seq": 12,
+    })
+    system2, client2 = await _drive_turn(plugin, fake_llm, [increment])
+    assert "[跨端最近对话]" in system2
+    block2 = system2.split("[跨端最近对话]======")[1].split("======[跨端最近对话结束]")[0]
+    assert "主人: 桌面消息" in block2
+    assert "微信消息" not in block2, "本会话自己回流的消息必须被过滤，不得双重注入"
+    assert client2.get.await_args.kwargs["params"]["since_seq"] == 10
