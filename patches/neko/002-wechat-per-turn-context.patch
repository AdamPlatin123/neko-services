@@ -747,6 +757,125 @@ class WechatIntegrationPlugin(NekoPluginBase):
             pass
         return None
 
+    async def _fetch_recent_history_increment(
+        self, her_name: str, since_seq: int, limit: int = 50,
+    ) -> Optional[dict[str, Any]]:
+        """GET /recent_history/{her}?since_seq= 取共享记忆的增量（p1-1 L1）。
+
+        成功（HTTP 2xx 且 body status=ok）返回完整 payload（含 entries/next_seq）；
+        任何失败返回 None——调用方降级为"跳过注入、水位不动、下轮重试"，绝不
+        阻塞回复。WARN 带 request_id 便于按轮次追踪。
+        """
+        request_id = uuid.uuid4().hex[:8]
+        try:
+            import httpx
+            from config import MEMORY_SERVER_PORT
+            async with httpx.AsyncClient(timeout=5.0, proxy=None, trust_env=False) as client:
+                response = await client.get(
+                    f"http://127.0.0.1:{MEMORY_SERVER_PORT}/recent_history/{her_name}",
+                    params={"since_seq": int(since_seq), "limit": int(limit)},
+                )
+            if not response.is_success:
+                self.logger.warning(
+                    "[wechat_integration] recent_history increment failed: "
+                    f"status={response.status_code} her={her_name} since_seq={since_seq} "
+                    f"request_id={request_id}"
+                )
+                return None
+            payload = response.json()
+            if not isinstance(payload, dict) or payload.get("status") != "ok":
+                # 端点失败模式是 200 + status:error——统一在这里拦下
+                self.logger.warning(
+                    "[wechat_integration] recent_history increment error body: "
+                    f"her={her_name} since_seq={since_seq} "
+                    f"body={str(payload)[:200]} request_id={request_id}"
+                )
+                return None
+            return payload
+        except Exception as e:
+            self.logger.warning(
+                "[wechat_integration] recent_history increment unavailable: "
+                f"her={her_name} since_seq={since_seq} error={e} request_id={request_id}"
+            )
+            return None
+
+    async def _refresh_cross_context(
+        self,
+        session: dict[str, Any],
+        her_name: str,
+        current_message: str,
+        *,
+        baseline_context: Optional[str],
+    ) -> Optional[str]:
+        """维护跨端上下文水位，返回本轮要注入 system 的增量块（或 None）。
+
+        - 新会话（baseline_context 非空）：/new_dialog 已经渲染了全部近期历史，
+          只把水位对齐到当前 next_seq、**不注入**——否则同一段内容会双重注入
+          （这正是旧 GET /get_recent_history 不能直接用的原因）。baseline 拿不到
+          （memory server 刚好没回）时走下面的全量兜底，等价于延迟一轮取基线。
+        - 活跃会话：按水位取增量；recent_history 不区分消息来源通道，本会话
+          自己经 /cache 回流的消息也在增量里——用「本会话滑窗 + 本轮消息」的
+          (role, content) 精确匹配过滤掉；同一条消息不重复注入由 seq 水位保证
+          （水位只在成功拿到 payload 后推进）。已知局限：主人在别的通道发了
+          一字不差的内容会被误滤（罕见，只丢一次注入，无害）；若未来存储层
+          带上通道/会话来源字段，应改为按来源过滤。
+        """
+        watermark = int(session.get("cross_context_next_seq") or 0)
+        if baseline_context:
+            payload = await self._fetch_recent_history_increment(
+                her_name, since_seq=0, limit=1,  # 只需要 next_seq，不需要内容
+            )
+            if payload is not None:
+                # 与下方活跃分支同款防御：畸形 next_seq 不能让 int() 抛异常——
+                # 这里抛出去会被 _generate_wechat_reply 的外层 except 吞掉，
+                # 整轮无回复。对齐失败就保持水位 0，下一轮活跃分支重试取。
+                try:
+                    session["cross_context_next_seq"] = int(payload.get("next_seq") or 0)
+                except (TypeError, ValueError):
+                    session["cross_context_next_seq"] = 0
+            return None
+
+        payload = await self._fetch_recent_history_increment(her_name, since_seq=watermark)
+        if payload is None:
+            return None
+        try:
+            next_seq = int(payload.get("next_seq") or watermark)
+        except (TypeError, ValueError):
+            next_seq = watermark
+        session["cross_context_next_seq"] = max(next_seq, watermark)
+
+        entries = [
+            e for e in (payload.get("entries") or [])
+            if isinstance(e, dict) and str(e.get("content") or "").strip()
+        ]
+        own_turns = {
+            (h.get("role"), h.get("content"))
+            for h in (session.get("history") or [])
+            if isinstance(h, dict)
+        }
+        own_turns.add(("user", current_message))
+        injected = [
+            e for e in entries
+            if (e.get("role"), e.get("content")) not in own_turns
+        ]
+        if not injected:
+            return None
+        lines = [
+            f"{e.get('speaker') or e.get('role')}: {e.get('content')}"
+            for e in injected
+        ]
+        self.logger.info(
+            "[wechat_integration] cross-context increment: "
+            f"entries={len(injected)}/{len(entries)} next_seq={next_seq}"
+        )
+        return (
+            "======[跨端最近对话]======\n"
+            "以下是刚刚在其他通道（桌面/QQ 等）发生的对话，供你了解近况；"
+            "不要主动复述，也无需回应其中已结束的话题：\n"
+            + "\n".join(lines)
+            + "\n======[跨端最近对话结束]======"
+        )
+
     @staticmethod
     async def _cache_memory_delta(her_name: str, messages: list[dict[str, Any]]) -> None:
         """缓存增量对话到 Memory Server"""
