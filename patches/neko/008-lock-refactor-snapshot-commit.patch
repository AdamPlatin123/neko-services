+# -*- coding: utf-8 -*-
+"""Settle-lock refactor tests (UC3 Final Gate 1a-3, patch 008).
+
+摘要 LLM 移出角色级 settle lock 临界区：update_history(phase_lock=...) 把
+「append 落盘段」与「splice 提交段」各自包进角色锁短临界区，压缩 LLM 夹在
+两段之间（锁外）跑。设计文档 P1-1 必做验收：
+
+- 「摘要执行期间另一入口持续 /cache 与 /recent_history 读取」——并发测试：
+  慢 LLM mock + 并发写不阻塞不超时；
+- splice = 版本校验后提交（fingerprint 锚点）：压缩期间落入的新消息保留；
+- new_dialog 语义保持：in-flight 标记 + 有界等待，绝不读到半压缩状态（也
+  绝不悬死——LLM 失败/异常/取消路径统一收口）；
+- 期间涌入量再次超阈值 → 剩余量留待下次（不循环再压）。
+"""
+from __future__ import annotations
+
+import asyncio
+import json
+from pathlib import Path
+
+import pytest
+
+from memory.recent import CompressedRecentHistoryManager
+from utils.llm_client import AIMessage, HumanMessage, SystemMessage, messages_from_dict
+
+pytestmark = pytest.mark.unit
+
+_LANLAN = "Xiaoba"
+_MASTER = "Master"
+
+_LLM_SECONDS = 0.5          # 慢 LLM mock 的驻留时长
+_BLOCK_ASSERT_BELOW = 0.3   # "不阻塞"断言上限（须明显小于 _LLM_SECONDS）
+
+
+class _FakeConfigManager:
+    def __init__(self, memory_dir: str, recent_log: dict):
+        self.memory_dir = memory_dir
+        self._recent_log = recent_log
+
+    def get_character_data(self):
+        return self.aget_character_data_sync()
+
+    def aget_character_data_sync(self):
+        return (
+            _MASTER, _LANLAN, None, {},
+            {"human": _MASTER, "ai": _LANLAN, "system": "SYSTEM_MESSAGE"},
+            None, None, None, self._recent_log,
+        )
+
+    async def aget_character_data(self):
+        return self.aget_character_data_sync()
+
+
+def _make_manager(tmp_path: Path) -> CompressedRecentHistoryManager:
+    file_path = str(tmp_path / "recent.json")
+    mgr = object.__new__(CompressedRecentHistoryManager)
+    mgr._config_manager = _FakeConfigManager(str(tmp_path), {_LANLAN: file_path})
+    mgr.max_history_length = 10
+    mgr.compress_threshold = 15
+    mgr.log_file_path = {_LANLAN: file_path}
+    mgr.name_mapping = {"human": _MASTER, "ai": _LANLAN, "system": "SYSTEM_MESSAGE"}
+    mgr.user_histories = {}
+    mgr._seq_counters = {}
+    return mgr
+
+
+def _read_disk_messages(file_path: str) -> list:
+    with open(file_path, encoding="utf-8") as f:
+        return messages_from_dict(json.load(f))
+
+
+@pytest.fixture(autouse=True)
+def _patch_cloudsave(monkeypatch):
+    monkeypatch.setattr(
+        "memory.recent.assert_cloudsave_writable", lambda *a, **kw: None,
+    )
+
+
+class _SlowCompress:
+    """慢 LLM mock：记录调用次数、入口放行事件，驻留 _LLM_SECONDS 后返回 memo。"""
+
+    def __init__(self):
+        self.calls = 0
+        self.started = asyncio.Event()
+
+    async def __call__(self, messages, lanlan_name, detailed=False):
+        self.calls += 1
+        self.started.set()
+        await asyncio.sleep(_LLM_SECONDS)
+        return (SystemMessage(content=f"memo #{self.calls}"),)
+
+
+async def _fill_history(mgr, count: int, prefix: str = "seed"):
+    """灌入超过 compress_threshold 的历史（不触发压缩）。"""
+    for i in range(count):
+        await mgr.update_history(
+            [HumanMessage(content=f"{prefix}-{i}")], _LANLAN, compress=False,
+        )
+
+
+# ─────────────────── 1. 摘要期间 /cache 不被阻塞 ───────────────────
+
+
+async def test_cache_write_not_blocked_by_slow_summary_llm(tmp_path):
+    mgr = _make_manager(tmp_path)
+    file_path = mgr.log_file_path[_LANLAN]
+    await _fill_history(mgr, 16)  # threshold=15 → 下一次 update_history 触发压缩
+    slow = _SlowCompress()
+    mgr.compress_history = slow
+
+    lock = asyncio.Lock()
+    loop = asyncio.get_running_loop()
+
+    # /settle 型调用（phase_lock 分段，模拟 routes 的新结构）
+    settle_task = asyncio.create_task(
+        mgr.update_history([], _LANLAN, detailed=True, phase_lock=lock)
+    )
+    await slow.started.wait()  # LLM 已开跑（此时角色锁已释放）
+
+    # 摘要执行期间另一入口的 /cache：routes 侧是锁内短临界区
+    t0 = loop.time()
+    async with lock:
+        await mgr.update_history(
+            [HumanMessage(content="cached during llm")], _LANLAN, compress=False,
+        )
+    elapsed = loop.time() - t0
+    assert elapsed < _BLOCK_ASSERT_BELOW, (
+        f"/cache 在摘要 LLM 期间被阻塞 {elapsed:.2f}s（应 < {_BLOCK_ASSERT_BELOW}s）"
+    )
+
+    await settle_task
+    assert slow.calls == 1
+
+    # 压缩期间落入的消息保留（splice 锚点校验通过，merged 非 moot）
+    final = _read_disk_messages(file_path)
+    assert isinstance(final[0], SystemMessage) and final[0].content == "memo #1"
+    assert any(m.content == "cached during llm" for m in final), (
+        "压缩期间 /cache 落入的消息必须保留在压缩后尾部"
+    )
+
+
+async def test_recent_history_read_not_blocked_by_slow_summary_llm(tmp_path):
+    mgr = _make_manager(tmp_path)
+    await _fill_history(mgr, 16)
+    slow = _SlowCompress()
+    mgr.compress_history = slow
+
+    lock = asyncio.Lock()
+    settle_task = asyncio.create_task(
+        mgr.update_history([], _LANLAN, detailed=True, phase_lock=lock)
+    )
+    await slow.started.wait()
+
+    loop = asyncio.get_running_loop()
+    t0 = loop.time()
+    history = await mgr.aget_recent_history(_LANLAN)
+    elapsed = loop.time() - t0
+    assert len(history) >= 16
+    assert elapsed < _BLOCK_ASSERT_BELOW, (
+        f"/recent_history 读取在摘要期间被阻塞 {elapsed:.2f}s"
+    )
+
+    await settle_task
+
+
+# ─────────────────── 2. new_dialog 语义：in-flight 等待 ───────────────────
+
+
+async def test_new_dialog_waits_for_inflight_compression(tmp_path):
+    mgr = _make_manager(tmp_path)
+    await _fill_history(mgr, 16)
+    slow = _SlowCompress()
+    mgr.compress_history = slow
+
+    lock = asyncio.Lock()
+    settle_task = asyncio.create_task(
+        mgr.update_history([], _LANLAN, detailed=True, phase_lock=lock)
+    )
+    await slow.started.wait()
+    assert mgr.is_compress_inflight(_LANLAN), "LLM 驻留期间应为 in-flight"
+
+    # /new_dialog 侧的等待（routes._new_dialog 的等待原语）挂起且不返回
+    waiter = asyncio.create_task(
+        mgr.wait_compress_settled(_LANLAN, timeout=10.0)
+    )
+    await asyncio.sleep(0.1)
+    assert not waiter.done(), "压缩未收口前等待不得返回"
+
+    await settle_task
+    assert await asyncio.wait_for(waiter, timeout=1.0), "splice 收口后等待应返回"
+    assert not mgr.is_compress_inflight(_LANLAN)
+
+
+async def test_wait_compress_settled_times_out_and_is_consistent(tmp_path):
+    """超时分支：返回 False，调用方读当前状态（完整原文，同样一致）。"""
+    mgr = _make_manager(tmp_path)
+    assert await mgr.wait_compress_settled(_LANLAN, timeout=0.01) is True  # 空闲即返回
+
+    mgr._mark_compress_inflight(_LANLAN)
+    try:
+        assert await mgr.wait_compress_settled(_LANLAN, timeout=0.05) is False
+    finally:
+        mgr._clear_compress_inflight(_LANLAN)
+
+
+async def test_inflight_cleared_on_llm_failure(tmp_path):
+    """摘要失败（返回 None）：跳过压缩保留原文，in-flight 收口。"""
+    mgr = _make_manager(tmp_path)
+    await _fill_history(mgr, 16)
+
+    async def _failing(messages, lanlan_name, detailed=False):
+        await asyncio.sleep(0.05)
+        return None
+
+    mgr.compress_history = _failing
+    await mgr.update_history([], _LANLAN, detailed=True, phase_lock=asyncio.Lock())
+    assert not mgr.is_compress_inflight(_LANLAN)
+    final = _read_disk_messages(mgr.log_file_path[_LANLAN])
+    assert len(final) == 16 and all(not isinstance(m, SystemMessage) for m in final), (
+        "摘要失败必须保留原始历史"
+    )
+
+
+async def test_inflight_cleared_on_llm_exception_and_cancel(tmp_path):
+    mgr = _make_manager(tmp_path)
+    await _fill_history(mgr, 16)
+
+    async def _boom(messages, lanlan_name, detailed=False):
+        await asyncio.sleep(0.05)
+        raise RuntimeError("provider down")
+
+    mgr.compress_history = _boom
+    # 异常路径：update_history 吞掉（记 error log），但 in-flight 必须收口
+    await mgr.update_history([], _LANLAN, detailed=True, phase_lock=asyncio.Lock())
+    assert not mgr.is_compress_inflight(_LANLAN)
+
+    # 取消路径
+    async def _hang(messages, lanlan_name, detailed=False):
+        await asyncio.sleep(60)
+
+    mgr.compress_history = _hang
+    mgr._seq_counters = {}
+    task = asyncio.create_task(
+        mgr.update_history(
+            [HumanMessage(content="cancel me")], _LANLAN, phase_lock=asyncio.Lock(),
+        )
+    )
+    await asyncio.sleep(0.05)
+    assert mgr.is_compress_inflight(_LANLAN)
+    task.cancel()
+    with pytest.raises(asyncio.CancelledError):
+        await task
+    assert not mgr.is_compress_inflight(_LANLAN), "取消路径也必须收口 in-flight"
+
+
+# ─────────────────── 3. 剩余量留待下次 ───────────────────
+
+
+async def test_influx_during_compression_left_for_next_round(tmp_path):
+    """压缩期间涌入大量消息再次超阈值 → 本轮只压一次，剩余量留待下次。"""
+    mgr = _make_manager(tmp_path)
+    file_path = mgr.log_file_path[_LANLAN]
+    await _fill_history(mgr, 16)
+    slow = _SlowCompress()
+    mgr.compress_history = slow
+
+    lock = asyncio.Lock()
+    settle_task = asyncio.create_task(
+        mgr.update_history([], _LANLAN, detailed=True, phase_lock=lock)
+    )
+    await slow.started.wait()
+    # 压缩期间涌入 12 条（splice 后将再次超过 threshold=15）
+    for i in range(12):
+        async with lock:
+            await mgr.update_history(
+                [HumanMessage(content=f"influx-{i}")], _LANLAN, compress=False,
+            )
+    await settle_task
+
+    assert slow.calls == 1, "本轮不得循环再压（最简单正确方案：留待下次）"
+    final = _read_disk_messages(file_path)
+    assert isinstance(final[0], SystemMessage)
+    assert sum(1 for m in final if m.content.startswith("influx-")) == 12, (
+        "压缩期间涌入的消息全部保留"
+    )
+
+    # 下一次 update_history 处理剩余量
+    await mgr.update_history(
+        [HumanMessage(content="next round")], _LANLAN, phase_lock=lock,
+    )
+    assert slow.calls == 2, "剩余量由下一次压缩处理"
+
+
+# ─────────────────── 4. after_append 顺序语义 ───────────────────
+
+
+async def test_after_append_runs_before_llm_within_lock(tmp_path):
+    """astore（after_append）在 append 段内、压缩 LLM 之前执行（角色锁内）。"""
+    mgr = _make_manager(tmp_path)
+    await _fill_history(mgr, 16)
+
+    order: list[str] = []
+    lock = asyncio.Lock()
+
+    async def _astore():
+        order.append("astore")
+        assert lock.locked(), "after_append 必须仍在角色锁内执行"
+
+    class _OrderedCompress(_SlowCompress):
+        async def __call__(self, messages, lanlan_name, detailed=False):
+            order.append("llm")
+            return await super().__call__(messages, lanlan_name, detailed)
+
+    mgr.compress_history = _OrderedCompress()
+    await mgr.update_history(
+        [], _LANLAN, detailed=True, phase_lock=lock, after_append=_astore,
+    )
+    assert order == ["astore", "llm"]
+
+
+async def test_after_append_skipped_on_stale_identity(tmp_path):
+    """stale 身份（RecentFileDeletedError）在 append 段中断 → astore 不执行。"""
+    from utils.recent_file import RecentFileDeletedError
+
+    mgr = _make_manager(tmp_path)
+    called: list[str] = []
+
+    async def _astore():
+        called.append("should-not-run")
+
+    def _stale_append(*args, **kwargs):
+        raise RecentFileDeletedError("identity replaced")
+
+    mgr._append_and_persist_locked = _stale_append
+    lock = asyncio.Lock()
+    with pytest.raises(RecentFileDeletedError):
+        await mgr.update_history(
+            [HumanMessage(content="stale batch")], _LANLAN,
+            phase_lock=lock, after_append=_astore,
+        )
+    assert called == []
+
+
+# ─────────────────── 5. 无 phase_lock 的旧路径不回归 ───────────────────
+
+
+async def test_legacy_call_without_phase_lock_still_works(tmp_path):
+    """/process 型调用（锁外、无 phase_lock）行为不变：正常压缩+合并。"""
+    mgr = _make_manager(tmp_path)
+    file_path = mgr.log_file_path[_LANLAN]
+    await _fill_history(mgr, 16)
+    slow = _SlowCompress()
+    mgr.compress_history = slow
+
+    await mgr.update_history([HumanMessage(content="process batch")], _LANLAN)
+    assert slow.calls == 1
+    final = _read_disk_messages(file_path)
+    assert isinstance(final[0], SystemMessage)
+    assert any(m.content == "process batch" for m in final)
+    assert not mgr.is_compress_inflight(_LANLAN)
+
+
+async def test_phase_lock_acquire_release_cycle_between_phases(tmp_path):
+    """段间锁确实释放过：压缩 LLM 驻留期间锁可被第三方获取。"""
+    mgr = _make_manager(tmp_path)
+    await _fill_history(mgr, 16)
+    slow = _SlowCompress()
+    mgr.compress_history = slow
+
+    lock = asyncio.Lock()
+    settle_task = asyncio.create_task(
+        mgr.update_history([], _LANLAN, detailed=True, phase_lock=lock)
+    )
+    await slow.started.wait()
+    # LLM 驻留=段1 已结束、段3 未开始 → 锁应可获取
+    acquired = lock.locked() is False
+    async with lock:
+        pass
+    await settle_task
+    assert acquired, "压缩 LLM 驻留期间角色锁必须处于释放状态"
