+# ── 存储层自增 seq（跨端增量读取用，p1-1 L1）──────────────────────────
+# recent.json 的存储格式是"纯消息列表"（messages_to_dict → [{type, data}]），没有
+# 现成的逐条稳定序号；time_indexed.db 的行按 /cache 批次（uuid session_id）落库、
+# 批内共享同一 timestamp，同样不能充当逐条单调序。因此引入存储层自增 seq：每条新
+# 对话消息在落盘临界区内打上 additional_kwargs.recent_seq（附 recent_seq_ts 记录
+# 打点时刻），计数器按角色持久化在 recent.json 同目录的 recent_seq_state.json。
+#
+# 选 additional_kwargs 而非改列表结构：messages_to_dict/from_dict 已完整往返该字段
+# （utils/llm_client/messages.py），所有既有读写方零感知——
+#   - 压缩 memo（SystemMessage）不打点、不占号：增量端点明确排除 system 条目；
+#   - review 改写生成的新消息对象不带 seq → 对增量端点不可见，不会把"改写前已被
+#     读走的内容"再次推送（改写结果仍经 /new_dialog 的渲染链可见）；
+#   - 硬上限裁剪只删最旧条目，幸存条目 seq 不变，游标语义不受影响；
+#   - 计数器 floor = max(sidecar 高水位, 盘上/pending 已打点最大 seq)，recent.json
+#     被重置清空后也不会回退复用旧号。
+RECENT_SEQ_KWARG = 'recent_seq'
+RECENT_SEQ_TS_KWARG = 'recent_seq_ts'
+RECENT_SEQ_STATE_FILENAME = 'recent_seq_state.json'
+
+
+def message_recent_seq(message) -> int | None:
+    """Return the stamped monotonic seq of a message, or None when unstamped."""
+    kwargs = getattr(message, 'additional_kwargs', None)
+    if not isinstance(kwargs, dict):
+        return None
+    seq = kwargs.get(RECENT_SEQ_KWARG)
+    if isinstance(seq, bool) or not isinstance(seq, int) or seq < 0:
+        return None
+    return seq
+
+
+def _entry_text_content(message) -> str:
+    """Flatten a message's content into plain text (multimodal parts joined)."""
+    content = getattr(message, 'content', '')
+    if isinstance(content, str):
+        return content
+    if isinstance(content, list):
+        parts = []
+        for item in content:
+            if isinstance(item, dict):
+                parts.append(str(item.get('text') or item.get('content') or ''))
+            else:
+                parts.append(str(item))
+        return '\n'.join(parts)
+    return str(content or '')
+
+
+def extract_recent_seq_entries(history: list) -> list[dict]:
+    """Extract seq-stamped dialogue entries (ascending by seq).
+
+    Feeds the incremental read endpoint (GET /recent_history/{name}). System
+    messages (compression memos) and unstamped entries (legacy recent.json
+    content written before the seq stamping landed, review rewrites) are
+    excluded — see the RECENT_SEQ_* block comment for the exact semantics.
+    """
+    entries = []
+    for message in history:
+        if isinstance(message, SystemMessage):
+            continue
+        seq = message_recent_seq(message)
+        if seq is None:
+            continue
+        kwargs = getattr(message, 'additional_kwargs', None) or {}
+        ts = kwargs.get(RECENT_SEQ_TS_KWARG)
+        entries.append({
+            'seq': seq,
+            # role: 稳定枚举（user/assistant/…）；type: 存储层原始类型（human/ai）
+            'role': getattr(message, 'role', None) or getattr(message, 'type', ''),
+            'type': getattr(message, 'type', ''),
+            'content': _entry_text_content(message),
+            'ts': str(ts) if ts else None,
+        })
+    entries.sort(key=lambda e: e['seq'])
+    return entries
+
+
+def build_recent_history_increment(
+    stamped: list[dict],
+    *,
+    since_seq: int,
+    limit: int,
+) -> tuple[list[dict], int]:
+    """Apply the cursor window over ``extract_recent_seq_entries`` output.
+
+    Returns ``(tail_entries, next_seq)``:
+
+    - ``tail_entries``：seq > since_seq 的条目按 seq 升序，超过 ``limit`` 时
+      截尾保留**最新**的 limit 条（更旧的增量被跳过且不会再出现）；
+    - ``next_seq``：调用方应保存的水位 = 最后一条返回条目的 seq+1；无新条目
+      时 = max(since_seq, 历史最大 seq)+1——对任一调用方单调推进、绝不回退。
+    """
+    max_seq = stamped[-1]['seq'] if stamped else 0
+    fresh = [e for e in stamped if e['seq'] > since_seq]
+    tail = fresh[len(fresh) - limit:] if len(fresh) > limit else fresh
+    next_seq = (tail[-1]['seq'] if tail else max(since_seq, max_seq)) + 1
+    return tail, next_seq
+
 
