+def test_update_history_stamps_monotonic_seq_and_persists(tmp_path):
+    mgr = _make_manager(tmp_path)
+    file_path = mgr.log_file_path[_LANLAN]
+
+    asyncio.run(mgr.update_history(
+        [HumanMessage(content="hello"), AIMessage(content="hi there")],
+        _LANLAN, compress=False,
+    ))
+    asyncio.run(mgr.update_history(
+        [HumanMessage(content="second turn")], _LANLAN, compress=False,
+    ))
+
+    final = _read_disk_messages(file_path)
+    seqs = [message_recent_seq(m) for m in final]
+    assert seqs == [1, 2, 3], f"seq 应从 1 起连续单调，实际 {seqs}"
+    assert not isinstance(final[0], SystemMessage)
+    # ts 打点随 seq 一起持久化
+    for m in final:
+        assert m.additional_kwargs.get("recent_seq_ts")
+
+    # sidecar 高水位同步推进
+    state_path = os.path.join(os.path.dirname(file_path), RECENT_SEQ_STATE_FILENAME)
+    with open(state_path, encoding="utf-8") as f:
+        assert json.load(f) == {"highwater": 3}
