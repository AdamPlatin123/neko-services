+async def _drive_endpoint(tmp_path, stamped_history, params):
+    """Mount the real route on the real app with hermetic runtime swaps."""
+    import httpx
+    from app.memory_server import routes, runtime
+
+    mgr = _make_manager(tmp_path)
+    mgr.user_histories[_LANLAN] = list(stamped_history)
+
+    async def _fake_aget(name, **kwargs):
+        return list(mgr.user_histories.get(name, ()))
+
+    fake_manager = type("FakeManager", (), {"aget_recent_history": staticmethod(_fake_aget)})()
+
+    saved = (
+        runtime.recent_history_manager, runtime._config_manager,
+        runtime._memory_runtime_init_completed, runtime._memory_storage_blocked_after_init,
+    )
+    runtime.recent_history_manager = fake_manager
+    runtime._config_manager = mgr._config_manager
+    # storage_limited_mode_guard 中间件在 startup 钩子完成前对一切路径 409 短路；
+    # 测试里置位"初始化已完成"，让请求到达路由本身。
+    runtime._memory_runtime_init_completed = True
+    runtime._memory_storage_blocked_after_init = False
+    try:
+        transport = httpx.ASGITransport(app=routes.app)
+        async with httpx.AsyncClient(
+            transport=transport, base_url="http://127.0.0.1",
+        ) as client:
+            return await client.get(f"/recent_history/{_LANLAN}", params=params)
+    finally:
+        (
+            runtime.recent_history_manager, runtime._config_manager,
+            runtime._memory_runtime_init_completed, runtime._memory_storage_blocked_after_init,
+        ) = saved
+
+
+def _stamped_entry(seq: int, content: str, type_: str = "human"):
+    msg = HumanMessage(content=content) if type_ == "human" else AIMessage(content=content)
+    msg.additional_kwargs[RECENT_SEQ_KWARG] = seq
+    msg.additional_kwargs["recent_seq_ts"] = f"2026-09-19T12:00:{seq:02d}"
+    return msg
+
+
+@pytest.mark.asyncio
+async def test_endpoint_returns_contract_shape_and_instance_id(tmp_path):
+    history = [
+        _stamped_entry(1, "u1"),
+        _stamped_entry(2, "a1", "ai"),
+        _stamped_entry(3, "u2"),
+    ]
+    resp = await _drive_endpoint(tmp_path, history, {})
+    assert resp.status_code == 200
+    body = resp.json()
+
+    assert body["status"] == "ok"
+    assert body["next_seq"] == 4
+    assert isinstance(body["instance_id"], str) and body["instance_id"]
+    assert [e["seq"] for e in body["entries"]] == [1, 2, 3]
+    first = body["entries"][0]
+    assert set(first.keys()) == {"seq", "role", "speaker", "content", "ts"}
+    # role=稳定枚举；speaker=name_mapping 解析后的显示名
+    assert first["role"] == "user" and first["speaker"] == _MASTER
+    assert body["entries"][1]["role"] == "assistant" and body["entries"][1]["speaker"] == _LANLAN
+    assert first["ts"] == "2026-09-19T12:00:01"
