+def test_counter_floor_prevents_seq_reuse_after_history_reset(tmp_path):
+    """recent.json 被重置清空后，sidecar 高水位兜底——seq 不回退复用旧号。"""
+    mgr = _make_manager(tmp_path)
+    file_path = mgr.log_file_path[_LANLAN]
+
+    asyncio.run(mgr.update_history(
+        [HumanMessage(content="u1"), AIMessage(content="a1")],
+        _LANLAN, compress=False,
+    ))
+    state_path = os.path.join(os.path.dirname(file_path), RECENT_SEQ_STATE_FILENAME)
+    # 拉高 sidecar 模拟"盘上曾打到 5 号后被整体清空"
+    with open(state_path, "w", encoding="utf-8") as f:
+        json.dump({"highwater": 5}, f)
+    with open(file_path, "w", encoding="utf-8") as f:
+        json.dump([], f)
+
+    asyncio.run(mgr.update_history(
+        [HumanMessage(content="fresh")], _LANLAN, compress=False,
+    ))
+
+    final = _read_disk_messages(file_path)
+    assert message_recent_seq(final[0]) == 6, "清空后新条目应从高水位+1 继续，不复用旧号"
