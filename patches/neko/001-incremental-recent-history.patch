+def test_memo_system_messages_do_not_consume_seq_numbers(tmp_path):
+    """压缩 memo（SystemMessage）不打点、不占号——增量流里永远不该出现 system。"""
+    mgr = _make_manager(tmp_path)
+    file_path = mgr.log_file_path[_LANLAN]
+
+    asyncio.run(mgr.update_history(
+        [HumanMessage(content="u1"), AIMessage(content="a1")],
+        _LANLAN, compress=False,
+    ))
+    # 模拟一次压缩 splice：头部换成 memo，尾部保留
+    disk = _read_disk_messages(file_path)
+    memo = SystemMessage(content="先前对话的备忘录: ...")
+    merged = [memo] + disk
+    from utils.llm_client import messages_to_dict
+    from utils import recent_file
+    with recent_file.recent_file_access(file_path):
+        recent_file.write_recent_payload_unlocked(file_path, messages_to_dict(merged))
+
+    asyncio.run(mgr.update_history(
+        [HumanMessage(content="u2")], _LANLAN, compress=False,
+    ))
+
+    final = _read_disk_messages(file_path)
+    seqs = [message_recent_seq(m) for m in final]
+    # memo 不占号：新对话条目直接续在既有最大 seq 之后
+    assert message_recent_seq(final[0]) is None
+    assert seqs[1:] == [1, 2, 3], f"memo 后的对话 seq 应为 1,2,3，实际 {seqs}"
