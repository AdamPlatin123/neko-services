+# -*- coding: utf-8 -*-
+"""Contract tests for the incremental recent-history read path (p1-1 L1).
+
+Covers three layers of GET /recent_history/{name}?since_seq=&limit=:
+
+1. storage stamping — update_history assigns a per-character monotonic seq
+   (persisted via recent_seq_state.json) inside the append critical section;
+2. extraction/window — extract_recent_seq_entries + build_recent_history_increment
+   (shape, cursor, tail-limit, watermark monotonicity);
+3. the HTTP endpoint itself — mounted on the real memory_server FastAPI app with
+   the runtime components swapped for hermetic fakes (same spirit as
+   tests/integration/test_funnel_endpoint.py, but here the real route module is
+   importable and thin, so we exercise the real wrapper instead of duplicating it).
+
+Why a NEW endpoint instead of GET /get_recent_history: the old one renders
+prompt-locale PlainText with no cursor — injecting it per turn would double-inject
+everything already covered by /new_dialog's recent section.
+"""
+from __future__ import annotations
+
+import asyncio
+import json
+import os
+from pathlib import Path
+
+import pytest
+
+from memory.recent import (
+    RECENT_SEQ_KWARG,
+    RECENT_SEQ_STATE_FILENAME,
+    CompressedRecentHistoryManager,
+    build_recent_history_increment,
+    extract_recent_seq_entries,
+    message_recent_seq,
+)
+from utils.llm_client import (
+    AIMessage,
+    HumanMessage,
+    SystemMessage,
+    messages_from_dict,
+)
+
+pytestmark = pytest.mark.unit
+
+_LANLAN = "Xiaoba"
+_MASTER = "Master"
+
+
+class _FakeConfigManager:
+    """只提供 update_history / aget_recent_history 路径用到的字段。"""
+
+    def __init__(self, memory_dir: str, recent_log: dict):
+        self.memory_dir = memory_dir
+        self._recent_log = recent_log
+
+    def get_character_data(self):
+        return self.aget_character_data_sync()
+
+    def aget_character_data_sync(self):
+        # 9 元组布局对齐 CompressedRecentHistoryManager 的解包：
+        # (master, her, ?, catgirl_data, name_mapping, lanlan_prompt_map, ?, ?, recent_log)
+        return (
+            _MASTER, _LANLAN, None, {},
+            {"human": _MASTER, "ai": _LANLAN, "system": "SYSTEM_MESSAGE"},
+            None, None, None, self._recent_log,
+        )
+
+    async def aget_character_data(self):
+        return self.aget_character_data_sync()
+
+
+def _make_manager(tmp_path: Path) -> CompressedRecentHistoryManager:
+    """Build a manager without the real ConfigManager (bypasses __init__)."""
+    file_path = str(tmp_path / "recent.json")
+    mgr = object.__new__(CompressedRecentHistoryManager)
+    mgr._config_manager = _FakeConfigManager(str(tmp_path), {_LANLAN: file_path})
+    mgr.max_history_length = 10
+    mgr.compress_threshold = 15
+    mgr.log_file_path = {_LANLAN: file_path}
+    mgr.name_mapping = {"human": _MASTER, "ai": _LANLAN, "system": "SYSTEM_MESSAGE"}
+    mgr.user_histories = {}
+    mgr._seq_counters = {}
+    return mgr
+
+
+def _read_disk_messages(file_path: str) -> list:
+    with open(file_path, encoding="utf-8") as f:
+        return messages_from_dict(json.load(f))
+
+
+@pytest.fixture(autouse=True)
+def _patch_cloudsave(monkeypatch):
+    monkeypatch.setattr(
+        "memory.recent.assert_cloudsave_writable", lambda *a, **kw: None,
+    )
