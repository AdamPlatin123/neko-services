+def test_build_recent_history_increment_cursor_limit_and_watermark():
+    stamped = [
+        {"seq": i, "role": "user", "type": "human", "content": f"m{i}", "ts": None}
+        for i in range(1, 11)  # seq 1..10
+    ]
+
+    # 全量 + tail-limit：超过 limit 保留最新一侧
+    tail, next_seq = build_recent_history_increment(stamped, since_seq=0, limit=3)
+    assert [e["seq"] for e in tail] == [8, 9, 10]
+    assert next_seq == 11
+
+    # 增量：只取水位之后的
+    tail, next_seq = build_recent_history_increment(stamped, since_seq=4, limit=50)
+    assert [e["seq"] for e in tail] == [5, 6, 7, 8, 9, 10]
+    assert next_seq == 11
+
+    # 无新条目：水位 = max(since, max_seq)+1，绝不回退
+    tail, next_seq = build_recent_history_increment(stamped, since_seq=10, limit=50)
+    assert tail == [] and next_seq == 11
+    # 水位领先于历史（历史被裁剪/重置）：继续单调推进
+    tail, next_seq = build_recent_history_increment(stamped, since_seq=20, limit=50)
+    assert tail == [] and next_seq == 21
+
+    # 空历史：next_seq=1，与首条消息将拿到的 seq 对齐
+    tail, next_seq = build_recent_history_increment([], since_seq=0, limit=50)
+    assert tail == [] and next_seq == 1
