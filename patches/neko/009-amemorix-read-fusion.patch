+def test_fuse_rrf_ordering_and_id_isolation():
+    """双源各 2 条：RRF 分数决定总排序；a-memorix id 带前缀，不与本地撞名。"""
+    payload = {
+        "results": [_hybrid_row("fact_a", 0.9), _hybrid_row("fact_b", 0.5)],
+        "query": "q", "candidates_total": 10, "elapsed_ms": 1.0,
+    }
+    hits = [_hit("amem content x", 0.8), _hit("amem content y", 0.4)]
+
+    fused = fuse_hybrid_with_amemorix(payload, hits, k=60)
+
+    # k=60：rank1=1/61≈0.016393，rank2=1/62≈0.016129（不同名条目按各自 rank）
+    scores = {r["id"]: r["score"] for r in fused["results"]}
+    assert scores["fact_a"] == pytest.approx(1 / 61, abs=1e-6)
+    assert scores[f"{A_MEMORIX_TIER}:h-amem content x"] == pytest.approx(1 / 61, abs=1e-6)
+    assert scores["fact_b"] == pytest.approx(1 / 62, abs=1e-6)
+    # 排序：rank1 的两条在前（同分按 dict 序，不做次序断言），rank2 在后
+    assert fused["results"][0]["score"] >= fused["results"][2]["score"]
+
+    # id 前缀隔离：a-memorix 条目绝不冒充本地 fact/reflection id
+    amem_rows = [r for r in fused["results"] if r["tier"] == A_MEMORIX_TIER]
+    assert len(amem_rows) == 2
+    assert all(r["id"].startswith(f"{A_MEMORIX_TIER}:") for r in amem_rows)
+    assert amem_rows[0]["text"] == "amem content x"
+
+    # 原地不可变：入参 payload 不被改动
+    assert len(payload["results"]) == 2
+    assert "a_memorix_contributions" not in payload
+    # 可观测字段
+    assert fused["a_memorix_contributions"] == 2
+    assert fused["candidates_total"] == 12
