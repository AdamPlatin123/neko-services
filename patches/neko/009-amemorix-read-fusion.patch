+class _EndpointHarness:
+    """POST /query_memory with hermetic runtime swaps + mocked recall layers."""
+
+    def __init__(self, tmp_path, monkeypatch, *, enabled, hits, subjects=None):
+        from app.memory_server import routes, runtime
+
+        self._routes = routes
+        self._runtime = runtime
+        self.asearch_calls: list[str] = []
+
+        async def _fake_hybrid_recall(**kwargs):
+            return {
+                "results": [_hybrid_row("fact_local", 0.03)],
+                "query": kwargs.get("query") or "",
+                "candidates_total": 3, "elapsed_ms": 0.5,
+            }
+
+        async def _fake_asearch(name, query, **kwargs):
+            self.asearch_calls.append(query)
+            return hits
+
+        # /query_memory 里是函数内 from memory.hybrid_recall import hybrid_recall
+        # ——patch 源模块的属性才能拦住局部 import。
+        import memory.hybrid_recall as hybrid_module
+        monkeypatch.setattr(hybrid_module, "hybrid_recall", _fake_hybrid_recall)
+        monkeypatch.setattr(amemorix_client, "is_read_fusion_enabled", lambda: enabled)
+        monkeypatch.setattr(amemorix_client, "asearch", _fake_asearch)
+
+        self._saved = (
+            runtime.fact_store, runtime.reflection_engine,
+            runtime._memory_runtime_init_completed,
+            runtime._memory_storage_blocked_after_init,
+        )
+        runtime.fact_store = object()
+        runtime.reflection_engine = object()
+        runtime._memory_runtime_init_completed = True
+        runtime._memory_storage_blocked_after_init = False
+        self._subjects = subjects
+
+    async def post(self, query="hello?", time=None):
+        body = {"query": query}
+        if time:
+            body["time"] = time
+        if self._subjects is not None:
+            body["subjects"] = self._subjects
+        transport = httpx.ASGITransport(app=self._routes.app)
+        async with httpx.AsyncClient(
+            transport=transport, base_url="http://127.0.0.1",
+        ) as client:
+            return await client.post(f"/query_memory/{_LANLAN}", json=body)
+
+    def restore(self):
+        (
+            self._runtime.fact_store, self._runtime.reflection_engine,
+            self._runtime._memory_runtime_init_completed,
+            self._runtime._memory_storage_blocked_after_init,
+        ) = self._saved
