+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+"""a-memorix-service 读侧客户端（UC1 Final Gate 转正 #8，patch 009）。
+
+只做**检索路**（读融合）：/query_memory 的 RRF 融合 + /new_dialog 的
+to_text 块。写钩子（settle 后 ingest_text/ingest_summary）是 P0-1 服务化
+的另一条线，不在这里。
+
+HTTP 契约（照 MaiBot 宿主 MemoryService/MemoryHit 的 wire 格式，见
+neko-services/docs/design/module-interface-audit.md §3/§6——请求体照抄
+KernelSearchRequest 的字段名，响应照抄 MemorySearchResult.to_dict）::
+
+    POST {A_MEMORIX_URL}/a_memorix/v1/search
+    body: {"query": str, "limit": int, "chat_id": str}
+    resp: {"success": bool, "hits": [MemoryHit.to_dict()...], "filtered": bool, ...}
+          MemoryHit.to_dict 键: content/score/type/source/hash/metadata/episode_id/title
+
+降级纪律（设计文档 S2 故障表）：不可达/超时（A_MEMORIX_TIMEOUT_SECONDS）/
+形状异常 → 返回空 + WARN，**绝不阻塞单源检索**——a-memorix 是增益路，不是
+依赖路。默认 off（A_MEMORIX_READ_FUSION_ENABLED），部署 a-memorix-service
+时置 NEKO_A_MEMORIX_READ_FUSION_ENABLED=1。
+"""
+from __future__ import annotations
+
+import asyncio
+from typing import Any
+
+import httpx
+
+from config import (
+    A_MEMORIX_FUSION_RRF_K,
+    A_MEMORIX_NEW_DIALOG_MAX_CONTENT_CHARS,
+    A_MEMORIX_NEW_DIALOG_TOP_K,
+    A_MEMORIX_QUERY_LIMIT,
+    A_MEMORIX_READ_FUSION_ENABLED,
+    A_MEMORIX_TIMEOUT_SECONDS,
+    A_MEMORIX_URL,
+)
+from utils.logger_config import get_module_logger
+from utils.tokenize import count_tokens
+
+logger = get_module_logger(__name__, "Memory")
+
+A_MEMORIX_SEARCH_PATH = "/a_memorix/v1/search"
+
+# 融合结果里 a-memorix 条目的 tier 标识（hybrid_recall 的 tier 枚举新增一员；
+# 渲染侧按 tier 透传，不认识的新值原样展示）。
+A_MEMORIX_TIER = "a_memorix"
+
+
+def is_read_fusion_enabled() -> bool:
+    """读融合总开关（默认 off；env NEKO_A_MEMORIX_READ_FUSION_ENABLED=1 开）。"""
+    return bool(A_MEMORIX_READ_FUSION_ENABLED)
+
+
+def _hit_id(hit: dict, index: int) -> str:
+    """a-memorix hit 的融合去重键——前缀隔离，绝不与本地 fact/reflection id 撞名。"""
+    raw = str(hit.get("hash") or hit.get("episode_id") or "").strip()
+    if not raw:
+        raw = f"idx{index}"
+    return f"{A_MEMORIX_TIER}:{raw}"
+
+
+async def asearch(
+    lanlan_name: str,
+    query: str,
+    *,
+    limit: int = A_MEMORIX_QUERY_LIMIT,
+    timeout: float = A_MEMORIX_TIMEOUT_SECONDS,
+    transport: httpx.AsyncBaseTransport | None = None,
+) -> list[dict]:
+    """Query a-memorix-service; degrade to [] + WARN on any failure.
+
+    ``transport`` 只给测试注入 MockTransport 用，生产路径不传。
+    """
+    if not query or not query.strip():
+        return []
+    url = f"{A_MEMORIX_URL.rstrip('/')}{A_MEMORIX_SEARCH_PATH}"
+    payload = {"query": query.strip(), "limit": int(limit), "chat_id": lanlan_name}
+    try:
+        async with httpx.AsyncClient(timeout=timeout, transport=transport) as client:
+            resp = await client.post(url, json=payload)
+            resp.raise_for_status()
+            body = resp.json()
+        if not isinstance(body, dict) or body.get("success") is False:
+            # 契约里 success=False 携带 error 字段；不把它当异常抛——降级语义一致
+            logger.warning(
+                "[a-memorix] %s: search 返回 success=false: %r", lanlan_name, body,
+            )
+            return []
+        hits = body.get("hits")
+        if not isinstance(hits, list):
+            logger.warning(
+                "[a-memorix] %s: search 响应 hits 形状异常(%s)，按降级处理",
+                lanlan_name, type(hits).__name__,
+            )
+            return []
+        return [h for h in hits if isinstance(h, dict) and str(h.get("content") or "").strip()]
+    except (asyncio.TimeoutError, httpx.TimeoutException):
+        # httpx 的超时是 httpx.TimeoutException（不是 asyncio.TimeoutError 的
+        # 子类），两个都归到超时口径。
+        logger.warning(
+            "[a-memorix] %s: search 超时(%.1fs)，降级单源检索", lanlan_name, timeout,
+        )
+        return []
+    except Exception as e:
+        logger.warning(
+            "[a-memorix] %s: search 不可达(%s: %s)，降级单源检索",
+            lanlan_name, type(e).__name__, e,
+        )
+        return []
+
+
+def _rrf_score(rank: int, k: int) -> float:
+    return 1.0 / (k + rank)
+
+
+def fuse_hybrid_with_amemorix(
+    hybrid_payload: dict[str, Any],
+    amem_hits: list[dict],
+    *,
+    k: int = A_MEMORIX_FUSION_RRF_K,
+) -> dict[str, Any]:
+    """RRF-fuse hybrid_recall results with a-memorix hits (in-place on a copy).
+
+    两路排名：hybrid_payload["results"]（已按融合分降序）与 amem_hits（按
+    score 降序）。RRF: score(d) = Σ 1/(k + rankᵢ(d))；去重键 = hybrid 条目的
+    ``id`` vs a-memorix 的 ``amemorix:<hash>`` 前缀键——两侧 id 空间隔离，
+    天然不合并（同一事实在两侧是两条独立证据，RRF 只做排序不做等价合并）。
+
+    返回新 dict（原 payload 不动）：results 重排、score 换成 RRF 分（6 位小
+    数，与 hybrid_recall 的可观测口径一致）、candidates_total 累加 a-memorix
+    命中数，另附 ``a_memorix_contributions`` 供可观测。
+    """
+    results = list(hybrid_payload.get("results") or [])
+    fused_scores: dict[str, float] = {}
+    by_id: dict[str, dict] = {}
+
+    for rank, row in enumerate(results, start=1):
+        did = str(row.get("id") or "")
+        if not did:
+            continue
+        by_id[did] = row
+        fused_scores[did] = fused_scores.get(did, 0.0) + _rrf_score(rank, k)
+
+    sorted_hits = sorted(
+        amem_hits, key=lambda h: float(h.get("score") or 0.0), reverse=True,
+    )
+    for rank, hit in enumerate(sorted_hits, start=1):
+        did = _hit_id(hit, rank - 1)
+        entry = {
+            "id": did,
+            "text": str(hit.get("content") or ""),
+            "tier": A_MEMORIX_TIER,
+            "entity": None,
+            "subject_kind": None,
+            "subject_id": None,
+            # a-memorix 是全局索引（无 subject scope 标注），融合条目标
+            # legacy_private 与单源路径默认一致；subjects 非空的群聊调用在
+            # 端点侧已整体跳过融合（安全边界），不会走到这里。
+            "scope": "legacy_private",
+            "score": 0.0,
+            "created_at": None,
+            "event_start_at": None,
+            "event_end_at": None,
+        }
+        by_id[did] = entry
+        fused_scores[did] = fused_scores.get(did, 0.0) + _rrf_score(rank, k)
+
+    ordered = sorted(fused_scores.keys(), key=lambda d: fused_scores[d], reverse=True)
+    fused_results = []
+    for did in ordered:
+        row = dict(by_id[did])
+        row["score"] = round(fused_scores[did], 6)
+        fused_results.append(row)
+
+    out = dict(hybrid_payload)
+    out["results"] = fused_results
+    out["candidates_total"] = int(hybrid_payload.get("candidates_total") or 0) + len(sorted_hits)
+    out["a_memorix_contributions"] = len(sorted_hits)
+    return out
+
+
+def _recent_dialog_query_text(history, max_chars: int = 400) -> str:
+    """拼 /new_dialog 的检索词：最近几条对话文本（截断防 prompt 爆炸）。"""
+    texts: list[str] = []
+    for message in list(history)[-6:]:
+        content = getattr(message, "content", "")
+        if isinstance(content, list):
+            content = " ".join(
+                str(p.get("text") or "") for p in content if isinstance(p, dict)
+            )
+        text = str(content or "").strip()
+        if text:
+            texts.append(text)
+    query = " ".join(texts).strip()
+    return query[:max_chars]
+
+
+def render_hits_as_text(
+    hits: list[dict],
+    *,
+    token_budget: int,
+    max_entries: int = A_MEMORIX_NEW_DIALOG_TOP_K,
+    max_content_chars: int = A_MEMORIX_NEW_DIALOG_MAX_CONTENT_CHARS,
+) -> str:
+    """to_text 风格渲染（照 MaiBot MemorySearchResult.to_text 的编号列表），
+    按 token 预算逐条收纳（预算来自 PERSONA_RENDER_MAX_TOKENS 总额度的剩余）。
+
+    每条计入「渲染行」的 token（前缀 + 截断后内容 + 换行），预算耗尽即停——
+    跳过而不是塞半条（半截记忆比没有更糟，SCOPED_RENDER_SUBJECT_MIN_TOKENS
+    同一哲学）。
+    """
+    lines: list[str] = []
+    spent = 0
+    for index, hit in enumerate(hits[: max(1, int(max_entries))], start=1):
+        content = str(hit.get("content") or "").strip().replace("\n", " ")
+        if max_content_chars and len(content) > max_content_chars:
+            content = content[:max_content_chars] + "..."
+        line = f"{index}. {content}"
+        cost = count_tokens(line) + 1  # +1 = 换行
+        if spent + cost > token_budget:
+            break
+        lines.append(line)
+        spent += cost
+    return "\n".join(lines)
+
+
+async def render_new_dialog_block(
+    lanlan_name: str,
+    recent_history: list,
+    *,
+    token_budget: int,
+    header: str,
+    transport: httpx.AsyncBaseTransport | None = None,
+) -> str:
+    """/new_dialog 的 a-memorix 跨源记忆块（无命中/未启用/预算耗尽 → 空串）。
+
+    检索词 = 最近几条对话文本（new_dialog 是会话开场，没有显式 query）；预算
+    是 PERSONA_RENDER_MAX_TOKENS 总额度扣除 persona 渲染已花后的剩余——两个
+    块共享同一总额度，persona 撑满时本块自然为空（预算纪律优先于注入欲望）。
+    """
+    if token_budget <= 0:
+        return ""
+    query = _recent_dialog_query_text(recent_history)
+    if not query:
+        return ""
+    hits = await asearch(lanlan_name, query, transport=transport)
+    if not hits:
+        return ""
+    body = render_hits_as_text(hits, token_budget=token_budget)
+    if not body:
+        return ""
+    return f"{header}{body}\n"
