+"""Host-environment context block for persona cards that declare ``env_context``.
+
+角色卡可在 ``_reserved.persona_override.env_context`` 声明需要宿主环境信息
+（系统用户名/主目录/OS/时间等）。桌面主进程在 prompt 组装处
+（``NotifyMixin._build_initial_prompt``）取好这些值并拼成一段自描述块追加进
+system prompt——**角色永远不自己执行 shell 命令**（原 monika 实现依赖
+``whoami``/``$USER``，跨宿主不可移植且有越界风险）。
+
+权限分层由消费方（角色卡挂载的昵称状态机等通用模块）约束：
+- 默认许可（可直接念出）：系统用户名、主目录路径、当前时间日期；
+- 需用户同意（先征求同意再念出）：操作系统/内核、主机名；
+- 绝对红线：文件内容、密钥凭据、历史记录等——本模块**从不采集**这些维度。
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+from utils.config_manager.reserved_schema import get_reserved
+
+# env_context 维度白名单。卡片可写 bool（= 全部默认维度）或维度名列表；
+# 未知维度名静默忽略（不采集、不报错）。
+DEFAULT_ENV_CONTEXT_DIMENSIONS = ("username", "home", "os", "hostname", "time")
+_KNOWN_DIMENSIONS = frozenset(DEFAULT_ENV_CONTEXT_DIMENSIONS)
+
+
+def persona_env_context_dimensions(character_payload: dict | None) -> tuple[str, ...]:
+    """Resolve the requested env-context dimensions from a character payload.
+
+    Returns ``()`` when the card does not declare ``env_context`` (the default —
+    injection stays off and upstream behaviour is unchanged). A truthy non-list
+    value (e.g. ``true``) means "all default dimensions".
+    """
+    if not isinstance(character_payload, dict):
+        return ()
+    declared = get_reserved(
+        character_payload,
+        "persona_override",
+        "env_context",
+        default=None,
+    )
+    if isinstance(declared, bool):
+        return DEFAULT_ENV_CONTEXT_DIMENSIONS if declared else ()
+    if isinstance(declared, str):
+        declared = [declared]
+    if not isinstance(declared, list):
+        return ()
+    dimensions = tuple(
+        str(item).strip().lower()
+        for item in declared
+        if str(item or "").strip().lower() in _KNOWN_DIMENSIONS
+    )
+    # 去重保序
+    return tuple(dict.fromkeys(dimensions))
+
+
+def collect_env_context(dimensions: tuple[str, ...]) -> dict[str, Any]:
+    """Collect the requested host-environment values (main process, no shell).
+
+    每个维度独立 try/except：单个维度采集失败（极端沙箱环境下 getpass 抛错等）
+    只是缺项，绝不影响其余维度或让 prompt 组装失败。
+    """
+    values: dict[str, Any] = {}
+    for dimension in dimensions:
+        try:
+            if dimension == "username":
+                import getpass
+
+                value = getpass.getuser()
+                if str(value or "").strip():
+                    values[dimension] = str(value).strip()
+            elif dimension == "home":
+                from pathlib import Path
+
+                value = str(Path.home())
+                if value.strip():
+                    values[dimension] = value
+            elif dimension == "os":
+                import platform
+
+                values[dimension] = f"{platform.system()} {platform.release()}".strip()
+            elif dimension == "hostname":
+                import socket
+
+                value = socket.gethostname()
+                if str(value or "").strip():
+                    values[dimension] = str(value).strip()
+            elif dimension == "time":
+                from datetime import datetime
+
+                values[dimension] = datetime.now().strftime("%Y-%m-%d %H:%M %A")
+        except Exception:  # pragma: no cover - defensive per dimension
+            continue
+    return values
+
+
+# 各维度的英文标签 + 用途注记（self-describing：角色卡模块按注记约束行为，
+# 例如 hostname 标注 needs-consent，对应昵称状态机模块的「需同意」层）。
+_DIMENSION_LABELS = {
+    "username": ("System username", "default-permitted: may address the user by it"),
+    "home": ("Home directory", "default-permitted"),
+    "os": ("Operating system", "needs-consent: ask before bringing it up"),
+    "hostname": ("Hostname", "needs-consent: ask before bringing it up"),
+    "time": ("Local time at session start", "default-permitted"),
+}
+
+
+def build_env_context_block(values: dict[str, Any]) -> str:
+    """Render the collected values as a self-describing prompt block.
+
+    纯渲染函数（可测）：块内用英文标签自描述，注记标注权限层级，消费方角色
+    模块据此决定「可直接念出 / 先征求同意」。空 values 返回 ``""``。
+    """
+    if not values:
+        return ""
+    lines = ["<Host Environment>"]
+    for dimension, label_and_note in _DIMENSION_LABELS.items():
+        if dimension not in values:
+            continue
+        label, note = label_and_note
+        lines.append(f"- {label}: {values[dimension]} ({note})")
+    lines.append("</Host Environment>")
+    return "\n".join(lines)
+
+
+def build_env_context_section(character_payload: dict | None) -> str:
+    """End-to-end helper: resolve dimensions → collect → render.
+
+    返回可直接追加进 system prompt 的文本（带前导空行分隔）；卡片未声明或
+    采集结果为空时返回 ``""``，调用方无需判空。
+    """
+    dimensions = persona_env_context_dimensions(character_payload)
+    if not dimensions:
+        return ""
+    block = build_env_context_block(collect_env_context(dimensions))
+    if not block:
+        return ""
+    return f"\n\n{block}"
