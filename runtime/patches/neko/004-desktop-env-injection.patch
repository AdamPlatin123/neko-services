+"""Desktop env-context injection tests (patch 004, neko-services P1-2).
+
+昵称状态机的桌面侧接线：主进程取好系统用户名/主目录/OS/时间注入 prompt 组装点
+（NotifyMixin._build_initial_prompt），不让模型执行 shell。覆盖：
+- 维度解析门控：卡片未声明 env_context → 不注入（上游默认行为零变化）；
+- 声明形态：bool true / 维度列表 / 未知维度忽略 / bool false 关闭；
+- 采集：monkeypatch getpass.getuser 证明来源是主进程（无 shell）；
+- 渲染：自描述块 + 权限层级注记（needs-consent 标注 os/hostname）；
+- 接线：_build_initial_prompt 末尾含 <Host Environment> 块，默认基础无 persona 声明时不含。
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from utils.persona_env_context import (
+    build_env_context_block,
+    build_env_context_section,
+    collect_env_context,
+    persona_env_context_dimensions,
+)
+
+pytestmark = [pytest.mark.plugin_integration]
+
+
+def _card(env_context) -> dict:
+    return {
+        "昵称": "莫妮卡",
+        "_reserved": {"persona_override": {"preset_id": "monika-default", "env_context": env_context}},
+    }
+
+
+# ── 维度解析门控 ────────────────────────────────────────────────
+
+
+def test_no_declaration_means_no_injection():
+    assert persona_env_context_dimensions({}) == ()
+    assert persona_env_context_dimensions({"_reserved": {}}) == ()
+    assert persona_env_context_dimensions(None) == ()
+    assert build_env_context_section({}) == ""
+
+
+def test_bool_true_enables_all_default_dimensions():
+    dims = persona_env_context_dimensions(_card(True))
+    assert set(dims) == {"username", "home", "os", "hostname", "time"}
+
+
+def test_bool_false_disables():
+    assert persona_env_context_dimensions(_card(False)) == ()
+
+
+def test_dimension_list_filters_unknown_and_dedupes():
+    dims = persona_env_context_dimensions(_card(["username", "time", "username", "shell_injection"]))
+    assert dims == ("username", "time")
+
+
+# ── 采集：主进程取值，无 shell ──────────────────────────────────
+
+
+def test_collect_uses_getpass_not_shell(monkeypatch):
+    import getpass
+
+    monkeypatch.setattr(getpass, "getuser", lambda: "adam")
+    values = collect_env_context(("username",))
+    assert values == {"username": "adam"}
+
+
+def test_collect_missing_dimension_is_skipped_not_fatal(monkeypatch):
+    import getpass
+
+    def _boom():
+        raise OSError("no tty")
+
+    monkeypatch.setattr(getpass, "getuser", _boom)
+    values = collect_env_context(("username", "time"))
+    assert "username" not in values
+    assert "time" in values  # 单维度失败不影响其余维度
+
+
+# ── 渲染：自描述块 + 权限层级注记 ───────────────────────────────
+
+
+def test_block_is_self_describing_with_consent_notes():
+    block = build_env_context_block(
+        {"username": "adam", "os": "Linux 6.14.0", "time": "2026-09-19 23:12 Friday"}
+    )
+    assert block.startswith("<Host Environment>") and block.endswith("</Host Environment>")
+    assert "- System username: adam" in block
+    assert "default-permitted" in block
+    assert "- Operating system: Linux 6.14.0" in block
+    assert "needs-consent" in block  # os/hostname 标注需同意
+    assert build_env_context_block({}) == ""
+
+
+def test_section_has_leading_separator_for_prompt_concat():
+    section = build_env_context_section(_card(["username"]))
+    assert section.startswith("\n\n<Host Environment>")
+    assert "- System username:" in section
+
+
+# ── 接线：_build_initial_prompt 组装点 ────────────────────────────
+
+
+def _make_stub_manager(monkeypatch, character_payload):
+    from main_logic.core.notify import NotifyMixin
+
+    mgr = NotifyMixin.__new__(NotifyMixin)
+    mgr.user_language = "zh-CN"
+    mgr.lanlan_name = "莫妮卡"
+    mgr.lanlan_prompt = "BASE_PROMPT_MARKER"
+    mgr.lanlan_basic_config = {"莫妮卡": character_payload}
+    mgr._is_agent_enabled = lambda: False
+    # directives / anti-repeat 注入是 try/except 包裹的独立段，stub 上允许其静默降级
+    return mgr
+
+
+async def test_build_initial_prompt_appends_env_block(monkeypatch):
+    import getpass
+
+    monkeypatch.setattr(getpass, "getuser", lambda: "adam")
+    mgr = _make_stub_manager(monkeypatch, _card(["username"]))
+    prompt = await mgr._build_initial_prompt()
+    assert "BASE_PROMPT_MARKER" in prompt
+    assert "<Host Environment>" in prompt
+    assert "- System username: adam" in prompt
+
+
+async def test_build_initial_prompt_unchanged_without_declaration(monkeypatch):
+    mgr = _make_stub_manager(
+        monkeypatch,
+        {"昵称": "YUI", "_reserved": {"avatar": {"live2d": {"model_path": ""}}}},
+    )
+    prompt = await mgr._build_initial_prompt()
+    assert "<Host Environment>" not in prompt
