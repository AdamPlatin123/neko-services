+# ── a-memorix 写钩子（p1-1 #9，UC1 转正后的检索索引写入）────────────────
+# 事实源唯一性原则（P1-1 #5）：memory_server 是唯一事实源，a-memorix 只存
+# 可重建的索引/派生数据。因此本钩子只在 memory_server 结算**成功后**触发，
+# 失败只 WARN 不重试——丢的块可随时从事实源重建（external_id 的内容哈希
+# 维度保证重建重放不会重复写入）。
+
+#: 环境变量未设置/为空 = 写钩子关闭（默认 off）；设置为服务根 URL 启用，
+#: 如 http://127.0.0.1:48921（与 neko-services scripts/lib.sh 的
+#: NEKO_AMEMORIX_URL 默认一致）。逐次读取（不缓存），便于测试与运行期开关。
+A_MEMORIX_URL_ENV = "A_MEMORIX_URL"
+
+
+def _a_memorix_base_url() -> str:
+    """Return the configured a-memorix base URL, or '' when the hook is off."""
+    return str(os.environ.get(A_MEMORIX_URL_ENV, "") or "").strip().rstrip("/")
+
+
+def _split_turn_blocks(chat_history: list, lanlan_name: str) -> list[str]:
+    """把会话历史切成 turn 块文本（user 边界切块），供 a-memorix ingest。
+
+    每块以一条 user 消息开头、到下一条 user 消息之前的全部 assistant 消息
+    结束（主动搭话等无 user 前导的 assistant 尾巴单独成块）。system 条目
+    （如"网络错误，您已断开连接！"）不是对话内容，跳过。空文本条目跳过。
+    """
+    blocks: list[str] = []
+    current: list[str] = []
+    for item in chat_history:
+        if not isinstance(item, dict):
+            continue
+        role = item.get("role")
+        if role not in ("user", "assistant"):
+            continue
+        text = _extract_chat_item_text(item).strip()
+        if not text:
+            continue
+        if role == "user" and current:
+            blocks.append("\n".join(current))
+            current = []
+        label = lanlan_name if role == "assistant" else "用户"
+        current.append(f"[{label}] {text}")
+    if current:
+        blocks.append("\n".join(current))
+    return blocks
+
+
+def _a_memorix_external_id(lanlan_name: str, block_text: str) -> str:
+    """external_id 规范 ``{channel}:{user_id}:{chat_id}:{turn_uid}:{seq}``。
+
+    - channel=neko_desktop：本写钩子只服务桌面主进程的 settle；wechat/qq
+      通道的钩子在各自插件侧落地时沿用同一规范（channel 维度预留）；
+    - user_id="adam"：**多用户预留维度的占位**（宪章 #6 / P0-0 #4）——MVP
+      单用户，未来多用户化时用真实账号 id 替换，近零成本对冲；
+    - chat_id=角色名：与 memory_server recent.json 的按角色分文件对齐；
+    - turn_uid=块内容 sha256 前 16 hex（64 位）：同内容重放得到同
+      external_id，幂等去重由 a-memorix 的外部幂等映射兜底（重复 settle 同
+      turn 不重复写）。取 16 hex 而非更短：8 hex（32 位）在万块级（~9k 块）
+      就有 ~1% 生日碰撞概率，两条不同对话会坍缩成一条被误去重；64 位下
+      碰撞需要的块数（~6e8）远超任何会话规模，可忽略。
+      已知局限（有意接受）：内容哈希做幂等键意味着**同一会话内一字不差的
+      重复 turn 块会被坍缩为一条**（例如用户连发两次相同的话且角色回复也
+      相同——真实对话中整 turn 逐字重复极罕见）。重复本身的频次信息不进
+      a-memorix 索引；memory_server 事实源仍保留完整逐条记录。
+    - seq：本钩子按 turn 块整体写入，恒 0；序号维度为未来 per-turn 近实时
+      通知（/cache 后单条 ingest、seq 递增）预留——见 _ingest_chat_history_
+      to_a_memorix 的决策注释。
+    """
+    content_hash = hashlib.sha256(block_text.encode("utf-8")).hexdigest()[:16]
+    return f"neko_desktop:adam:{lanlan_name}:{content_hash}:0"
+
+
+async def _ingest_turn_block_to_a_memorix(
+    base_url: str,
+    lanlan_name: str,
+    block_text: str,
+    *,
+    seq: int,
+) -> tuple[bool, str]:
+    """POST /a_memorix/v1/ingest_summary 写入一个 turn 块（mem-client 风格）。
+
+    走 ingest_summary（显式 text 非空 → 内部转 ingest_text(source_type=
+    "chat_summary")）：P0-1b 查证 a-memorix 的 scope 身份解析只认
+    chat_summary:*/web_import:* 前缀——聊天写入必须走该 source_type 路径，
+    裸 ingest_text + 自选 source_type 会造成检索 scope 缺口。
+
+    成功判定：HTTP 2xx 且 body 为 dict 且 ``success`` 不为 False——202 =
+    启动队列排队（WAL 回放，最终会写入）按成功对待。失败返回 (False, detail)，
+    调用方只 WARN 不重试。
+    """
+    request_id = uuid.uuid4().hex[:8]
+    payload = {
+        "external_id": _a_memorix_external_id(lanlan_name, block_text),
+        "chat_id": lanlan_name,
+        "text": block_text,
+        "participants": ["用户", lanlan_name],
+        "metadata": {
+            "channel": "neko_desktop",
+            "seq": int(seq),
+            "request_id": request_id,
+        },
+    }
+    try:
+        response = await get_internal_http_client().post(
+            f"{base_url}/a_memorix/v1/ingest_summary",
+            json=payload,
+            timeout=10.0,
+        )
+    except asyncio.CancelledError:
+        raise
+    except Exception as e:
+        return False, f"{type(e).__name__}: {e}"
+
+    if not response.is_success:
+        return False, f"HTTP {response.status_code}"
+    try:
+        result = response.json() if response.text else {}
+    except Exception:
+        return False, "non-JSON response"
+    if not isinstance(result, dict):
+        return False, f"unexpected response type: {type(result).__name__}"
+    if result.get("success") is False:
+        return False, str(result.get("error") or result.get("detail") or "unknown_error")
+    return True, ""
+
+
+async def _ingest_chat_history_to_a_memorix(
+    chat_history: list,
+    lanlan_name: str,
+    *,
+    trigger: str,
+) -> None:
+    """结算成功后把本会话对话批量写入 a-memorix（p1-1 #9 写钩子入口）。
+
+    触发点：session end 的 /process|/settle 成功后、renew session 的
+    /renew|/settle 成功后（两者都在 chat_history.clear() 之前取快照——
+    renew 清空历史后，剩余段由 session end 的快照覆盖，两批无重叠）。
+    语言切换屏障（is_context_reset_barrier）分支**不触发**：memory_server
+    侧都放弃了注定被丢弃的摘要，索引侧保持同一姿态（事实源唯一性）。
+
+    近实时通知的决策（workplan #9 的 L2 替代路径评估）：**降级为 settle 后
+    批量**，不做 /cache 后逐条 notify。理由：
+    1. a-memorix ingest_text 含 embedding 计算（非轻量请求），turn end 的
+       /cache 在本 connector 的消息主循环里 await——同循环还负责
+       gemini_response 流转发与 user transcript 通知，逐条 notify 最坏
+       每 turn 拖 10s 会卡住整个 sync 管道；
+    2. fire-and-forget 规避阻塞会引入无界并发 + external_id seq 状态机，
+       复杂度不成比例；
+    3. 读侧近实时由 L1（recent.json 每轮 /cache 秒级可读）兜底——a-memorix
+       是语义检索层，"会话结束后可检索"对 MVP 检索场景够用。块级
+       external_id 幂等让未来切换到 per-turn 通知时可以无损重放。
+    """
+    base_url = _a_memorix_base_url()
+    if not base_url:
+        return
+    blocks = _split_turn_blocks(chat_history, lanlan_name)
+    if not blocks:
+        return
+    results = await asyncio.gather(*(
+        _ingest_turn_block_to_a_memorix(base_url, lanlan_name, block, seq=i)
+        for i, block in enumerate(blocks)
+    ), return_exceptions=True)
+    failures = []
+    for i, outcome in enumerate(results):
+        if isinstance(outcome, BaseException) and not isinstance(outcome, Exception):
+            # CancelledError 等非 Exception 的 BaseException 不吞
+            raise outcome
+        if isinstance(outcome, Exception):
+            failures.append(f"#{i}: {type(outcome).__name__}: {outcome}")
+        elif not outcome[0]:
+            failures.append(f"#{i}: {outcome[1]}")
+    if failures:
+        # 只 WARN 不重试（重复 settle 幂等由 external_id 兜底；丢块可从
+        # memory_server 事实源重建——本钩子开头的事实源原则注释）。
+        logger.warning(
+            "[%s] a-memorix ingest (%s): %d/%d turn blocks failed: %s",
+            lanlan_name, trigger, len(failures), len(blocks),
+            "; ".join(failures[:5]),
+        )
+    else:
+        logger.info(
+            "[%s] a-memorix ingest (%s): %d turn blocks ok",
+            lanlan_name, trigger, len(blocks),
+        )
+
+
 async def _post_memory_server(
     endpoint: str,
     lanlan_name: str,
@@ -1067,6 +1253,14 @@ async def run_sync_connector(
