+def test_settle_paths_wire_the_write_hook():
+    """接入点守门（上游 test_no_recent_json_writer_bypasses_the_lock_module
+    的源码守门先例）：renew 与 session end 的结算成功分支都必须挂上写钩子，
+    且 session end 分支带语言屏障 guard。"""
+    source = inspect_source()
+    assert source.count("_ingest_chat_history_to_a_memorix(") >= 3, (
+        "定义 1 处 + renew/session_end 接入 2 处"
+    )
+    # session end 接入必须被 is_context_reset_barrier guard（屏障分支不进索引）
+    session_end_zone = source[source.index("session end 记忆结算完成"):]
+    barrier_guard = "if not is_context_reset_barrier:" in session_end_zone
+    assert barrier_guard, "语言切换屏障分支不得触发 a-memorix ingest"
+    # renew 接入在 clear 之前
+    renew_zone = source[
+        source.index("热重置记忆已成功上传"):source.index("'turn end', 'turn end agent_callback'")
+    ]
+    assert "_ingest_chat_history_to_a_memorix(" in renew_zone
+
+
+def inspect_source() -> str:
+    path = os.path.join(
+        os.path.dirname(__file__), "..", "..", "main_logic", "cross_server.py",
+    )
+    with open(path, encoding="utf-8") as f:
+        return f.read()
