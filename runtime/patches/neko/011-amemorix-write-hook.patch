+def _client_mock(post_response=None, side_effect=None):
+    client = MagicMock()
+    if side_effect is not None:
+        client.post = AsyncMock(side_effect=side_effect)
+    else:
+        client.post = AsyncMock(return_value=post_response)
+    return client
+
+
+def _resp(payload=None, status_code=200, is_success=True, text=""):
+    return SimpleNamespace(
+        status_code=status_code,
+        is_success=is_success,
+        text=text or (str(payload) if payload is not None else ""),
+        json=(lambda p: (lambda: p))(payload),
+    )
+
+
+async def test_ingest_block_posts_to_ingest_summary_with_contract_shape():
+    client = _client_mock(post_response=_resp({"success": True, "stored_ids": ["x"]}))
+
+    with patch.object(cross_server, "get_internal_http_client", return_value=client):
+        ok, detail = await cross_server._ingest_turn_block_to_a_memorix(
+            _BASE, _HER, "[用户] hi", seq=3,
+        )
+
+    assert ok is True and detail == ""
+    call = client.post.await_args
+    assert call.args[0] == f"{_BASE}/a_memorix/v1/ingest_summary"
+    payload = call.kwargs["json"]
+    # P0-1b：聊天写入必须走 chat_summary 语义——显式 text 的 ingest_summary
+    # 内部转 ingest_text(source_type="chat_summary")，scope 解析才认得。
+    assert payload["text"] == "[用户] hi"
+    assert payload["chat_id"] == _HER
+    assert payload["external_id"].startswith(f"neko_desktop:adam:{_HER}:")
+    assert payload["metadata"]["channel"] == "neko_desktop"
+    assert payload["metadata"]["seq"] == 3
