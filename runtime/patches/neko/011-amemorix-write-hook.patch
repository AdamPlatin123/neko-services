+# -*- coding: utf-8 -*-
+"""a-memorix 写钩子的测试（p1-1 #9，UC1 转正后的检索索引写入）。
+
+覆盖四层：
+
+1. turn 切分（_split_turn_blocks）：user 边界切块、无 user 前导的 assistant
+   尾巴单独成块、system 条目跳过、空文本跳过；
+2. external_id 规范（_a_memorix_external_id）：五段
+   ``{channel}:{user_id}:{chat_id}:{turn_uid}:{seq}``、内容哈希稳定（同内容
+   重放同 id → 幂等兜底）、不同内容不同 id；
+3. 单块 ingest（_ingest_turn_block_to_a_memorix）：请求形状（ingest_summary
+   端点 / chat_summary 语义走 ingest_summary 路径）、2xx+success 判定、
+   202 排队按成功、200+success:false 拦截、超时降级；
+4. 批量入口（_ingest_chat_history_to_a_memorix）：A_MEMORIX_URL 未设 =
+   默认 off 零调用、部分失败只 WARN 不抛（settle 主流程不受影响）、
+   空会话跳过；以及接入点守门（settle 成功分支确实挂上了钩子——上游
+   test_no_recent_json_writer_bypasses_the_lock_module 的源码守门先例）。
+"""
+from __future__ import annotations
+
+import asyncio
+import os
+import sys
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock, patch
+
+import pytest
+
+sys.path.append(os.path.abspath(os.path.join(os.path.dirname(__file__), "../../")))
+
+from main_logic import cross_server
+
+pytestmark = pytest.mark.unit
+
+_HER = "Xiaoba"
+_BASE = "http://127.0.0.1:48921"
+
+
+def _history(*roles_texts):
+    return [
+        {"role": role, "content": [{"type": "text", "text": text}]}
+        for role, text in roles_texts
+    ]
+
+
+# ─────────────────── 1. turn 切分 ───────────────────
+
+
+def test_split_turn_blocks_cuts_at_user_boundaries():
+    history = _history(
+        ("user", "你好"),
+        ("assistant", "你好呀"),
+        ("assistant", "补充一句"),
+        ("user", "第二句"),
+        ("assistant", "回复二"),
+    )
+    blocks = cross_server._split_turn_blocks(history, _HER)
+    assert blocks == [
+        f"[用户] 你好\n[{_HER}] 你好呀\n[{_HER}] 补充一句",
+        f"[用户] 第二句\n[{_HER}] 回复二",
+    ]
+
+
+def test_split_turn_blocks_proactive_assistant_tail_becomes_own_block():
+    """主动搭话（无 user 前导的 assistant）单独成块——它也是记忆。"""
+    history = _history(
+        ("assistant", "主动搭话"),
+        ("user", "回应"),
+        ("assistant", "回复"),
+    )
+    blocks = cross_server._split_turn_blocks(history, _HER)
+    assert blocks == [
+        f"[{_HER}] 主动搭话",
+        f"[用户] 回应\n[{_HER}] 回复",
+    ]
+
+
+def test_split_turn_blocks_skips_system_and_empty_entries():
+    history = [
+        {"role": "system", "content": [{"type": "text", "text": "网络错误，您已断开连接！"}]},
+        {"role": "user", "content": [{"type": "text", "text": "  "}]},
+        {"role": "user", "content": [{"type": "text", "text": "真消息"}]},
+        {"role": "assistant", "content": [{"type": "text", "text": "回"}]},
+    ]
+    blocks = cross_server._split_turn_blocks(history, _HER)
+    assert blocks == [f"[用户] 真消息\n[{_HER}] 回"]
+
+
+# ─────────────────── 2. external_id 规范 ───────────────────
+
+
+def test_external_id_follows_five_segment_spec():
+    external_id = cross_server._a_memorix_external_id(_HER, "[用户] hi")
+    parts = external_id.split(":")
+    assert len(parts) == 5
+    assert parts[0] == "neko_desktop", "channel 按会话来源=桌面主进程"
+    assert parts[1] == "adam", "user_id 是多用户预留维度的占位（见函数注释）"
+    assert parts[2] == _HER, "chat_id 与 recent.json 按角色分文件对齐"
+    # 16 hex = 64 位内容哈希：万块级生日碰撞概率可忽略（8 hex 时 ~9k 块即 1%）
+    assert len(parts[3]) == 16 and all(c in "0123456789abcdef" for c in parts[3])
