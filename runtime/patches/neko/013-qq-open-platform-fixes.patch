+    await conn.send_group_message_segments("g1", _group_text("**加粗**内容"))
+
+    body = http.requests[0][1]["json"]
+    # 关掉检测：无 Markdown 权限的机器人保底纯文本，不再切 msg_type=2。
+    assert body["content"] == "**加粗**内容"
+    assert "markdown" not in body
+    assert body.get("msg_type") != 2
