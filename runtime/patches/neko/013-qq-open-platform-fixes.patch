+# ==========================================
+# 发送侧官方约束常量与错误码表
+# ==========================================
+
+#: Identify 订阅的 intents 位。GROUP_AND_C2C_EVENT = 1 << 25，覆盖
+#: C2C_MESSAGE_CREATE + GROUP_AT_MESSAGE_CREATE——_receive_loop 只消费这两类。
+#: **不要**再按位或 1 << 12（DIRECT_MESSAGE，频道私信）：本连接器不处理
+#: DIRECT_MESSAGE_CREATE，而官方事件订阅页明示「传递了无权限的 intents，
+#: websocket 会报错并直接关闭连接」——未申请频道私信权限的机器人会卡在
+#: 鉴权被拒的循环重连里。
+_OPEN_INTENTS_GROUP_AND_C2C = 1 << 25
+
+#: keyboard 按钮 render_data.label 的官方字符上限，超限整条消息拒收
+#: （错误码 40034029）。action.data 是点击后回传的指令文本，不受此限。
+_KEYBOARD_LABEL_MAX_CHARS = 10
+
+#: 被动回复计数器的保留窗口。官方被动回复 msg_id 有效期：群 5 分钟（C2C
+#: 文档页首写 60 分钟但字段表写 5 分钟，自相矛盾，按 5 分钟保守设计）。
+#: 取 2 倍兜底——窗口之外的 msg_id 已不能用于被动回复，计数自然无意义。
+_PASSIVE_SEQ_WINDOW_SECONDS = 600.0
+
+#: 官方错误码 → 排障提示（发送侧高频项）。来源：bot.q.qq.com 错误码表 +
+#: 群/C2C 消息发送页（2026-09 核对）。未收录的 code 照原样打 code+message。
+_OPEN_SEND_ERROR_HINTS: dict[int, str] = {
+    304003: "机器人无 Markdown/模板权限，可在设置里关闭 Markdown 自动检测",
+    304036: "机器人无 Markdown/模板权限，可在设置里关闭 Markdown 自动检测",
+    40034127: "机器人无 Markdown/模板权限，可在设置里关闭 Markdown 自动检测",
+    40034100: "触发主动消息频控（单关系 20 条/分钟、每群每天 1000 条）",
+    40034006: "消息内容审核不通过",
+    40034029: "keyboard 按钮超限（每条最多 4 个，label 最多 10 字符）",
+    40054002: "机器人被禁言",
+    40054005: "msg_id+msg_seq 去重拒绝（同一条消息的被动回复次数超限或重复）",
+    40054010: "不允许发送该 URL",
+    40054013: "用户拒收消息",
+}
+
+
+def _describe_send_failure(direction: str, resp: Any, data: Any) -> str:
+    """把一次发送失败的 HTTP 响应拼成带错误码与含义的日志行。
+
+    官方网关对业务失败同样回 HTTP 4xx + JSON body（``{"code": ..., "message": ...}``），
+    httpx 不会抛异常——所以旧的 ``except`` 分支只兜得住网络错误，频控/去重/
+    无权限这类业务失败一律静默返回 None，排障只能靠「消息没到」反推。这里
+    至少把 code 翻译成人话，四种高频故障（频控/去重/拒收/无 Markdown 权限）
+    各自有可辨识的日志。
+    """
+    status = int(getattr(resp, "status_code", 0) or 0)
+    code_raw: Any = None
+    message = ""
+    if isinstance(data, dict):
+        code_raw = data.get("code")
+        message = str(data.get("message") or "")
+    parts = [f"[QQOpenPlatform] 发送{direction}失败: HTTP {status}"]
+    code_txt = str(code_raw).strip() if code_raw is not None else ""
+    if code_txt:
+        parts.append(f"code={code_txt}")
+        hint = ""
+        try:
+            hint = _OPEN_SEND_ERROR_HINTS.get(int(code_txt), "")
+        except (TypeError, ValueError):
+            hint = ""
+        if message:
+            parts.append(message)
+        if hint:
+            parts.append(f"（{hint}）")
+    elif message:
+        parts.append(message)
+    return " ".join(parts)
+
