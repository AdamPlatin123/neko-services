+# ── 修复 3：提示词不再鼓励 ark ──────────────────────────────────────
+
+
+def test_open_platform_prompt_no_longer_encourages_ark():
+    # 投递层无 ark 实现（按未投递记账），提示词继续鼓励 <ark> 只会让用户
+    # 看到 bot「想说卡片」却什么都收不到。注意不能断言 "ark" 子串缺席：
+    # "Markdown" 自带 "ark"。
+    assert "<ark" not in FORMAT_PROMPT_SECTION_OPEN_PLATFORM
+    assert "</ark" not in FORMAT_PROMPT_SECTION_OPEN_PLATFORM
+    # 其余输出能力未被误删。
+    assert "<keyboard>" in FORMAT_PROMPT_SECTION_OPEN_PLATFORM
+    assert "<sticker>" in FORMAT_PROMPT_SECTION_OPEN_PLATFORM
+    assert "<reply>" in FORMAT_PROMPT_SECTION_OPEN_PLATFORM
+    assert "{sticker_catalog}" in FORMAT_PROMPT_SECTION_OPEN_PLATFORM
