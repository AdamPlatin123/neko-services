@@ -0,0 +1,438 @@
+"""Send-path guards for the QQ Open Platform connector.
+
+The receive/identity layers had ~2000 lines of dedicated tests; the send
+path had none. Everything pinned here is a documented platform rule the
+connector used to violate:
+
+- intents: subscribing to a bit the bot has no permission for makes the
+  gateway close the WS during auth (official event-subscribe page). The
+  old handshake OR-ed in ``1 << 12`` (guild DMs) which this connector
+  never even dispatches.
+- msg_seq: the platform dedupes on (msg_id, msg_seq) and defaults an
+  absent msg_seq to 1, so the *second* passive reply to the same user
+  message was deterministically rejected (40054005) -- humanized
+  multi-block corrections and quote fixes hit this.
+- keyboard label: render_data.label is capped at 10 chars; a longer one
+  rejects the whole message (40034029).
+- markdown autodetection: a bot without markdown permission fails the
+  entire message when the text happens to contain MD marks, so the
+  detection needed an opt-out that stays live without reconnecting.
+- error reporting: business failures come back as HTTP 4xx + JSON
+  ``{"code": ...}`` which httpx does not raise on -- rate limits,
+  dedup rejections and refusals used to vanish into a silent ``None``.
+- ark: the prompt encouraged ``<ark>`` output while the delivery layer
+  has no ark implementation, so the model kept "sending" cards the user
+  never received. The prompt no longer advertises the tag; the delivery
+  side keeps treating a stray ``<ark>`` as undelivered (unchanged).
+"""
+
+import json
+import time
+
+import pytest
+
+from plugin.plugins.qq_auto_reply.prompt_fragment_templates import (
+    FORMAT_PROMPT_SECTION_OPEN_PLATFORM,
+)
+from plugin.plugins.qq_auto_reply.qq_open_plat import QQOpenPlatformConnection
+
+
+class _RecordingLogger:
+    def __init__(self):
+        self.warnings: list[str] = []
+
+    def info(self, msg):
+        pass
+
+    def warning(self, msg):
+        self.warnings.append(str(msg))
+
+    def error(self, msg):
+        pass
+
+
+class _FakeResponse:
+    def __init__(self, status_code: int, payload: dict | None = None, *, broken_json: bool = False):
+        self.status_code = status_code
+        self._payload = payload
+        self._broken_json = broken_json
+
+    def json(self):
+        if self._broken_json:
+            raise ValueError("not json")
+        return self._payload
+
+
+class _FakeHttp:
+    def __init__(self, responses: list[_FakeResponse]):
+        self._responses = list(responses)
+        self.requests: list[tuple[str, dict]] = []
+
+    async def post(self, url, **kw):
+        self.requests.append((url, kw))
+        return self._responses.pop(0)
+
+
+class _FakeWS:
+    def __init__(self, incoming: list[dict]):
+        self._incoming = list(incoming)
+        self.sent: list[dict] = []
+
+    async def recv(self):
+        return json.dumps(self._incoming.pop(0))
+
+    async def send(self, raw):
+        self.sent.append(json.loads(raw))
+
+
+def _conn(**kwargs) -> tuple[QQOpenPlatformConnection, _RecordingLogger]:
+    logger = _RecordingLogger()
+    conn = QQOpenPlatformConnection(
+        app_id="app-1", client_secret="secret", logger=logger, **kwargs
+    )
+    # 跳过 token 刷新（不发真实 HTTP）：只测发送体构造。
+    conn._token_expires_at = time.time() + 3600.0
+    return conn, logger
+
+
+def _bind_http(conn: QQOpenPlatformConnection, responses: list[_FakeResponse]) -> _FakeHttp:
+    http = _FakeHttp(responses)
+    conn._http = http
+    return http
+
+
+def _ok_response(msg_id: str = "ret-1") -> _FakeResponse:
+    return _FakeResponse(200, {"id": msg_id})
+
+
+def _group_text(text: str, reply_id: str = "") -> list[dict]:
+    segments = []
+    if reply_id:
+        segments.append({"type": "reply", "data": {"id": reply_id}})
+    segments.append({"type": "text", "data": {"text": text}})
+    return segments
+
+
+# ── 修复 1：intents 只订阅 GROUP_AND_C2C_EVENT ──────────────────────
+
+
+async def test_identify_intents_subscribe_only_group_and_c2c():
+    conn, _ = _conn()
+    ws = _FakeWS([
+        {"op": 10, "d": {"heartbeat_interval": 30000}},
+        {"op": 0, "t": "READY", "d": {"user": {"id": "u1", "username": "bot"}, "session_id": "s1"}},
+    ])
+    conn._ws = ws
+    conn._access_token = "tok"
+
+    await conn._handshake(is_reconnect=False)
+
+    identify = ws.sent[0]
+    assert identify["op"] == 2
+    # 1 << 12（DIRECT_MESSAGE/频道私信）必须消失：连接器不消费该事件，且
+    # 官方对「订阅了无权限的 intents」的处置是直接关闭 WS。
+    assert identify["d"]["intents"] == 1 << 25
+    assert identify["d"]["intents"] & (1 << 12) == 0
+
+
+# ── 修复 2：被动回复 msg_seq 按 msg_id 递增 ─────────────────────────
+
+
+async def test_passive_reply_msg_seq_increments_per_msg_id():
+    conn, _ = _conn()
+    http = _bind_http(conn, [_ok_response(), _ok_response(), _ok_response()])
+
+    await conn.send_group_message_segments("g1", _group_text("第一条", reply_id="m-1"))
+    await conn.send_group_message_segments("g1", _group_text("第二条", reply_id="m-1"))
+    await conn.send_group_message_segments("g1", _group_text("别的消息", reply_id="m-2"))
+
+    bodies = [kw["json"] for _, kw in http.requests]
+    # 同一 msg_id 的两次被动回复：msg_seq 必须互不相同（不填默认 1，重复
+    # 组合被去重拒绝 40054005）。
+    assert bodies[0]["msg_id"] == "m-1" and bodies[0]["msg_seq"] == 1
+    assert bodies[1]["msg_id"] == "m-1" and bodies[1]["msg_seq"] == 2
+    # 不同 msg_id 各自从 1 开始。
+    assert bodies[2]["msg_id"] == "m-2" and bodies[2]["msg_seq"] == 1
+
+
+async def test_passive_seq_counter_prunes_expired_entries():
+    conn, _ = _conn()
+    # 塞满过期计数（超过 64 条触发惰性清理），新 msg_id 不得受污染。
+    now = time.time()
+    conn._passive_seq = {
+        f"old-{i}": (9, now - 7200.0) for i in range(70)
+    }
+    http = _bind_http(conn, [_ok_response()])
+
+    await conn.send_group_message_segments("g1", _group_text("hi", reply_id="fresh-1"))
+
+    body = http.requests[0][1]["json"]
+    assert body["msg_seq"] == 1
+    assert "old-0" not in conn._passive_seq
+
+
+async def test_non_reply_group_message_carries_no_msg_fields():
+    conn, _ = _conn()
+    http = _bind_http(conn, [_ok_response()])
+
+    await conn.send_group_message_segments("g1", _group_text("主动消息"))
+
+    body = http.requests[0][1]["json"]
+    # 主动消息（无 msg_id）不携带被动回复字段——不能把 msg_seq 泄漏到
+    # 主动载荷里（平台会按 msg_seq 去重干扰正常发送语义）。
+    assert "msg_id" not in body
+    assert "msg_seq" not in body
+
+
+# ── 修复 5：Markdown 自动检测开关 ───────────────────────────────────
+
+
+async def test_markdown_detection_enabled_by_default():
+    conn, _ = _conn()
+    http = _bind_http(conn, [_ok_response()])
+
+    await conn.send_group_message_segments("g1", _group_text("**加粗**内容"))
+
+    body = http.requests[0][1]["json"]
+    assert body["msg_type"] == 2
+    assert body["markdown"]["content"] == "**加粗**内容"
