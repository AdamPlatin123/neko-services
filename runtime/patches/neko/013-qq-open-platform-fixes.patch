+                "intents": _OPEN_INTENTS_GROUP_AND_C2C,
                 "shard": [0, 1],
             },
         }))
@@ -466,6 +550,28 @@ class QQOpenPlatformConnection(QQConnectionBase):
         self, group_id: str, segments: list[dict[str, Any]], *, record_sent: bool = True, keyboard: str = ""
     ) -> Optional[str]:
         """将 OneBot segments 转换为 QQ 开放平台格式并发送"""
+
+        def _markdown_detection_enabled() -> bool:
+            # 回调缺省/非可调用 = 启用（保持既有行为）。开关只管「把普通文本
+            # 自动升级为 msg_type=2」这一支；显式 keyboard 载荷必须挂在
+            # markdown 消息上（官方按钮只作用于富文本），不受此开关影响。
+            cb = getattr(self, "_markdown_enabled", None)
+            return bool(cb()) if callable(cb) else True
