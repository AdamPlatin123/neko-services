# =============================================================================
# neko-memory.service — N.E.K.O memory_server 常驻服务（systemd user unit）
# 部署裁决（workplan P0-0 第 7 项 / mvp-tech-design DX-6）：
#   - 常驻进程统一走 systemd user unit，由 neko.target 一键启停；
#   - 主进程（48911 全家桶）由 launcher 手动/桌面启动，故意不在 target 内；
#   - NapCat 由 qq_auto_reply 插件托管（stdout 接日志文件），不设 unit。
#
# 安装前准备：
#   1. 在 N.E.K.O 仓库根执行 `uv sync`（Python 3.11）生成 .venv；
#   2. 若部署路径与本文件默认不同，替换下方所有
#      /mnt/shared/_Projects/N.E.K.O/N.E.K.O 前缀（systemd user unit 不支持
#      外部环境变量展开，统一用绝对路径；%h 仅可用于 home 目录下的部署）。
# =============================================================================

[Unit]
Description=N.E.K.O memory_server (central memory HTTP service, 127.0.0.1:48912)
Documentation=file:///mnt/shared/_Projects/N.E.K.O/neko-services/README.md
# 仅排序不作依赖（memory_server 绑定 127.0.0.1，无桌面环境亦可运行）
After=graphical-session.target
# stop/restart neko.target 时联动停本服务（Wants 只管启动不管停止）
PartOf=neko.target

[Service]
Type=exec
WorkingDirectory=/mnt/shared/_Projects/N.E.K.O/N.E.K.O
ExecStart=/mnt/shared/_Projects/N.E.K.O/N.E.K.O/.venv/bin/python -m app.memory_server
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
# 端口覆盖示例（默认 48912，见 config/network.py）：
# Environment=NEKO_MEMORY_PORT=48912
# 日志查看：journalctl --user -u neko-memory.service -f
# 单独启停：systemctl --user start|stop|status neko-memory.service

[Install]
WantedBy=default.target
