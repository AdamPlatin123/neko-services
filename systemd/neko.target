# =============================================================================
# neko.target — N.E.K.O 常驻服务集总入口（systemd user target）
# 部署裁决（workplan P0-0 第 7 项）：
#   - 「systemctl --user start neko.target」一键冷启全部常驻服务（目标 <2 分钟）；
#   - 主进程（48911 桌面全家桶）由 launcher 桌面/手动启动，故意不在本 target
#     内——桌面端与常驻服务解耦，关桌面不杀记忆服务；
#   - NapCat 由 qq_auto_reply 插件托管（进程树跟随插件生命周期，stdout 接
#     日志文件供 doctor 巡检），不设独立 unit；
#   - neko-a-memorix.service 为占位（ConditionPathExists 不满足时自动 skipped），
#     P0-1「a-memorix 服务化」落地后自动纳入，无需修改本文件。
# =============================================================================

[Unit]
Description=N.E.K.O resident services (memory_server + a-memorix)
Wants=neko-memory.service neko-a-memorix.service
After=neko-memory.service neko-a-memorix.service

[Install]
WantedBy=default.target
