# =============================================================================
# neko-agent.service — N.E.K.O agent_server（systemd user unit）
# 绑定 TOOL_SERVER_PORT（48915）——历史命名，/health 的 service 字段为
# "agent"（launcher_core/runtime.py 的 attach 三口表：MAIN/MEMORY/TOOL →
# main/memory/agent）。对齐 docker/entrypoint.sh 先例：-m app.agent_server。
# 拓扑与互斥说明见 neko-memory.service 头注释与 systemd/INSTALL.md。
# =============================================================================

[Unit]
Description=N.E.K.O agent_server (agent/tool HTTP service, 127.0.0.1:48915)
Documentation=file:///mnt/shared/_Projects/N.E.K.O/neko-services/README.md
# 启动顺序对齐 docker/entrypoint.sh：memory → main → agent
After=neko-main.service
# stop/restart neko.target 时联动停本服务（Wants 只管启动不管停止）
PartOf=neko.target

[Service]
Type=exec
WorkingDirectory=/mnt/shared/_Projects/N.E.K.O/N.E.K.O
ExecStart=/mnt/shared/_Projects/N.E.K.O/N.E.K.O/.venv/bin/python -m app.agent_server
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# 与 neko-memory / neko-main 共享同一部署值（占位，部署时三处统一替换）：
Environment=NEKO_INSTANCE_ID=00000000-0000-0000-0000-000000000000
# 端口覆盖示例（默认 48915；上游读 NEKO_TOOL_SERVER_PORT 或 TOOL_SERVER_PORT）：
# Environment=NEKO_TOOL_SERVER_PORT=48915
# 日志查看：journalctl --user -u neko-agent.service -f

[Install]
WantedBy=default.target
