{
  "name": "neko-desktop-app",
  "version": "0.1.0",
  "description": "N.E.K.O Companion Desktop —— 旧纸与墨：首启海报 + 纸质配置页 + Q 版桌宠（Vite + 原生 TypeScript，零 UI 框架）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:pet": "esbuild ../core/pet-engine/pet-demo.ts ../core/pet-engine/pet-mount.ts --bundle --format=iife --entry-names=[name]-bundle --outdir=../desktop-app-assets/vendor",
    "build": "npm run build:pet && tsc --noEmit && vite build",
    "preview": "vite preview",
    "serve": "node src/server/standalone.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch-model": "bash scripts/fetch-model.sh",
    "postinstall": "npm run build:pet"
  },
  "dependencies": {
    "pixi.js": "^7.4.3",
    "@pixi/sound": "^5.2.3",
    "pixi-live2d-display-advanced": "^1.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=23"
  }
}